-- ============================================================================
-- Sound Vision: визуальная индикация источников звука для слабослышащих
-- игроков. Корневой скрипт - композиционный корень и слой адаптеров.
--
-- Что делает мод: рисует на экране расходящиеся кольца в точке любого звука
-- (выстрелы, шаги, голос, физика, аномалии) - в том числе сквозь стены.
-- Слышимость - как в игре: показывается только то, что игрок реально
-- слышит (громкость из движка), расстояние управляет лишь размером и
-- прозрачностью кольца. Всё настраивается в MCM.
--
-- Слышимость по громкости (v2.0). Движок уже решил, слышен ли звук:
-- ИИ-слух ослабляет каждый звук линейно с расстоянием и глухостью стен
-- (xray-monolith, IGame_Level::SoundEvent_Register:
--   Power = (1 - dist/max_ai_distance) * volume * occlusion).
-- Колбэк npc_on_hear_callback отдаёт это ослабленное значение (power) и
-- квадрат расстояния до слушателя. Мы восстанавливаем громкость у ИГРОКА
-- обратным квадратом от якоря ИИ-наблюдения:
--   loud = power * (dl/dp)^2,  dl - ИИ-слушатель, dp - игрок.
-- Показываем событие, если loud >= порога (MCM) - никакой калибровки
-- отдельных источников: громкий выстрел виден издалека, тихий шаг - нет.
-- Источники без движковых данных (опрос мира: шаги/физика/зоны) несут
-- громкость от виртуальных якорей - см. sound_vision_detect.
--
-- Кто слышнее - тот и получает кольцо (v2.5). Для WPN_* событий решается,
-- что показывать: стрелка (якорь типа звука на его дистанции - он слышен)
-- или точку попадания пули (стрелок не слышен, а попадание рядом с игроком
-- слышно - "входящий огонь", громкость переносом замера ИИ-слушателя).
-- Вертолёты: винт - цикличный звук без ИИ-рассылки, канал слуха о полёте
-- молчит, но ПУЛИ приходят с who_id техники - она запоминается и пульсирует
-- оранжевым kind="vehicle" в живой позиции (свой потолок дальности в
-- sound_vision_events). Методы сталкеров (active_item) у техники не
-- щупаются: биндинг движка печатает ошибки в лог даже под pcall.
--
-- Выстрел живёт у ствола (v2.6). WPN_shoot - сам звук выстрела: он
-- излучается у дульного среза и якорится к стрелку ВСЕГДА, без сравнения
-- с точкой пули. Прежний порог «|стрелок - пуля| > 2 м» оставлял события с
-- пулей у ствола без якоря: громкость бралась переносом замера случайного
-- ИИ-слушателя, и у слушателя рядом со стрелком (dl ~ 3 м) обратный квадрат
-- давил 0.98*(3/43)^2 до 0.004 < 0.02 - игрок видел вспышки и слышал
-- стрельбу, а гейт резал кольца. Потолок дальности оружия поднят до 250 м
-- (KIND_CAP в sound_vision_events), чтобы пропускать всё, что слышит якорь
-- ANV_SHOT (до ~246 м).
--
-- Движковый факт -> кольцо (v2.7). «Слышимость как в игре» заменена на
-- контракт доступности: каждый звук, донесённый до мода, показывается
-- ВСЕГДА - без порога громкости и без антиспама. Гейт слышимости удалён
-- совсем: у движковых событий (канал слуха) он противоречил факту, а у
-- опроса мира резал звуки, которые слышно (гул зоны в 48 м давал
-- 0.0135 < 0.02 и молчал). Громкость осталась только на размере и яркости
-- кольца. Weapon-кольца защищены от вытеснения из очереди: при переполнении
-- выталкивается самое старое НЕ-weapon событие (шаги/физика/гул зон),
-- а не красная метка (см. sound_vision_events).
--
-- Маркер атаки - ВСЕГДА (v2.7). Канал слуха молчит чаще, чем ожидалось:
-- у части паков оружия выстрел без валидного ogg-комментария получает
-- game_type = 0 и ИИ его не рассылает вовсе, а если рядом со стрелком нет
-- ни одного ИИ-слушателя, канал слуха не даст ни одной строки. Колбэка
-- npc_on_weapon_shot_start в Anomaly 1.5.2 НЕТ (список колбэков
-- anomaly-modding-book; RegisterScriptCallback не проверяет имена -
-- «регистрация» не значит, что движок его вызовет: в логе боя 05.11 канал
-- не дал ни одной строки при активной стрельбе). Поэтому факт выстрела
-- добывается чистым Lua, на любой сборке:
--   - опрос боезапаса (shot_poll): раз в 200 мс у каждого живого сталкера
--     в 250 м читается active_item -> get_ammo_total(); счётчик упал -
--     выстрел, кольцо у стрелка (рост счётчика - перезарядка, кольца нет);
--   - actor_on_hit_callback: игрока задело - кольцо на том, кто нанёс
--     удар, даже если все прочие каналы молчали.
-- WPN_* от того, кто не сталкер, не мутант и не техника (зоны играют
-- thermal-разряд звуком класса «выстрел»), перекрашивается в anomaly:
-- раньше аномалия рисовала красное кольцо атаки за 150 м (лог 05.11:
-- who=zone_mine_thermal_weak -> weapon, кольцо в 168 м).
--
-- Архитектура (SRP: один модуль - одна ответственность, зависимости
-- однонаправленные, связывание ленивое через глобальные таблицы модулей):
--   sound_vision_config     - настройки (кэш значений MCM);
--   sound_vision_classify   - классификация звука по типу, цвета категорий;
--   sound_vision_events     - очередь событий: слышимость, антиспам, масштаб;
--   sound_vision_detect     - опрос мира: шаги, физика, зоны, болт (4 Гц);
--   sound_vision_projection - мир -> HUD: проекция и пин к краю экрана;
--   sound_vision_render     - пул колец, анимация, сглаживание переходов,
--                             виньетка центра и учёт перекрытия (v2.8);
--   sound_vision_occlusion  - виден ли источник напрямую / за стеной (v2.8);
--   sound_vision_log        - отладочный журнал (MCM: Отладка); теги HEAR/
--                             SHOT/GATE/QUEUE/RENDER/OCC отвечают на вопрос
--                             «звук ловим, а кольца нет - где теряем»;
--   sound_vision_mcm        - дерево настроек MCM + get_config().
--
-- Этот файл (SRP) отвечает только за:
--   1) адаптеры источников событий -> очередь (ниже);
--   2) регистрацию ванильных колбэков движка (on_game_start);
--   3) привязку кадров игры к детекту и рендеру;
--   4) отладочный фасад sound_vision_debug.
--
-- Источники событий (без перезаписи чужих файлов, только добавление):
--   1) npc_on_hear_callback (ванильный) - ИИ-слух: любой NPC/монстр что-то
--      услышал (выстрел, голос, шаги монстра, физика) - с громкостью
--   2) anomaly_on_before_activate (ванильный) - аномалия активируется
--      (шипение): болт, NPC, мутант попали в зону
--   3) actor_on_feeling_anomaly (ванильный) - игрок вошёл в поле аномалии
--   4) physic_object_on_hit_callback (ванильный) - удар по физическому
--      объекту (нож по бочке, пуля по ящику, кулак по коробке)
--   5) actor_on_item_drop (ванильный) - игрок выбросил предмет (стук)
--   6) sound_vision_detect - опрос мира (4 Гц): шаги, физика, гул зон, болт
--   7) actor_on_footstep (ванильный) - шаги самого игрока (выкл. по умолч.)
--   8) shot_poll - опрос боезапаса (чистый Lua, v2.7): КАЖДЫЙ выстрел NPC,
--      не зависит от ogg-метаданных и ИИ-слушателей; колбэк
--      npc_on_weapon_shot_start остаётся бонусом экзешников, где он есть
--   9) actor_on_hit_callback (ванильный) - игрока задело: кольцо на
--      атакующем, гарантированный маркер атаки в момент попадания
--
-- Зачем нужен 8: звук без валидного ogg-комментария получает
-- game_type = 0 (SoundRender_Source.cpp, конструктор) и движок его ИИ
-- вообще не рассылает (Event_Propagade требует g_type != 0), а самозвуки
-- мотиватор пропускает - у части паков оружия канал слуха молчит, хотя
-- игрок звук слышит; и если рядом со стрелком нет ни одного ИИ-слушателя,
-- канал слуха не даст ни одной строки. Опрос боезапаса закрывает оба
-- случая: он не зависит ни от метаданных, ни от слушателей.
--
-- Сигнатуры и паттерны взяты из:
--   robe127.github.io/stalker-anomaly-modding-guide (callbacks-reference)
--   исходников движка (github.com/themrdemonized/xray-monolith):
--   xr_hear.script, xr_motivator.script, IGame_Level.cpp, step_manager.cpp
--   исходников MCM 1.7 (github.com/RAX-Anomaly/Anomaly-Mod-Configuration-Menu)
--   реальных аддонов: Twitch Integration (мультифайловая структура,
--   ленивый экспорт модулей), targetID, Stealth Overhaul Reworked.
-- ============================================================================

-- ---------------------------------------------------------------------------
-- Адаптеры источников событий. Каждый только извлекает данные из колбэка
-- и отправляет событие в очередь; вся политика (включённость, категории,
-- дальность, антиспам, масштаб) живёт в sound_vision_events.
-- ---------------------------------------------------------------------------

-- ---------------------------------------------------------------------------
-- Общие помощники источников: расстояния, виртуальные якоря громкости,
-- проверка глушителя. Якорь - единая модель с sound_vision_detect:
-- { d_v, p_v } - на d_v метрах от источника громкость p_v, дальше -
-- обратный квадрат: pp = p_v * (d_v/dp)^2. Объявлены ДО обработчиков:
-- колбэки замыкаются на локали.
-- ---------------------------------------------------------------------------

-- Расстояние от игрока до объекта (nil, если позиция недоступна).
local function dist_to_actor(obj)
        local a = db.actor
        if not a or not obj then return nil end
        local ok, p = pcall(obj.position, obj)
        if not (ok and p and p.x) then return nil end
        local ap = a:position()
        local dx, dy, dz = p.x - ap.x, p.y - ap.y, p.z - ap.z
        return math.sqrt(dx * dx + dy * dy + dz * dz)
end

-- Громкость у игрока от виртуального якоря: pp = p_v * (d_v/dp)^2.
local function anchor_loud(anv, dp)
        if not dp or dp < 0.5 then return 1 end
        local pp = anv[2] * (anv[1] / dp) * (anv[1] / dp)
        if pp > 1 then pp = 1 end
        return pp
end

-- Тихий ли ствол: глушитель пристёгнут (weapon_is_silencer) или интегрирован
-- в конструкцию (weapon_silencer_status == 2, как у ВСС/Вал). На старых
-- экзешниках методы могут отсутствовать - pcall, при сомнении громкий якорь.
local function is_silenced(weapon)
        if not weapon then return false end
        local ok, st = pcall(weapon.weapon_silencer_status, weapon)
        if ok and st == 2 then return true end
        local ok2, attached = pcall(weapon.weapon_is_silencer, weapon)
        return ok2 and attached == true
end

-- Якоря опроса мира и физики (детект не имеет своих данных).
local ANV_ZONE_ACT = { 12, 0.30 }   -- шипение активации зоны: слышно до ~46 м
local ANV_PHYS_HIT  = { 10, 0.20 }  -- удар по бочке/ящику: до ~30 м
local ANV_PHYS_DROP = { 8, 0.15 }   -- выброшенный предмет: до ~22 м

-- Якоря гарантированного канала выстрелов (источник 8 ниже) и переносимых
-- событий слуха (v2.4): громкость перенесённого выстрела берётся от якоря
-- типа звука, а не от замера слушателя - стабильна от боя к бою.
local ANV_SHOT     = { 45, 0.60 }  -- выстрел без глушителя
local ANV_SHOT_SIL = { 20, 0.30 }  -- выстрел с глушителем
local ANV_RELOAD   = { 12, 0.22 }  -- перезарядка
local WPN_ANV_EMPTY = { 8, 0.15 }  -- сухой щелчок: вблизи
local WPN_ANV_DRAW  = { 8, 0.12 }  -- достал/убрал оружие

-- Техника в слуховом канале (v2.5). Вертолёт движок о себе не сообщает:
-- винт - цикличный звук, ИИ его не рассылает, в npc_on_hear_callback он не
-- приходит. Но ПУЛИ вертолёта приходят (WPN_* с who_id техники), а сама
-- техника - живой game object по who_id. Каждое такое событие обновляет
-- наблюдение (TTL), а кадровой петлёй техника пульсирует оранжевым кольцом
-- kind="vehicle" в своей живой позиции - «звук полёта» для слабослышащего.
local HELI_TTL_MS   = 90000   -- держим наблюдение столько после последней пули
local HELI_PULSE_MS = 3000    -- период пульса кольца техники
local HELI_MAX_D    = 600     -- дальше винт не даёт направления - не пульсируем
local ANV_HELI      = { 150, 0.60 } -- винт слышен очень далеко: до ~820 м
local heli_watch    = {}      -- [id техники] = time_global последнего слухового события
local heli_pulse_t  = 0       -- таймер пульса

-- Техника ли это: у вертолётов Anomaly имя и секция объекта - секция отряда
-- (simulation_helicopter_*), в ней есть "heli". Только строки, никаких
-- обращений к методам объекта: у техники они отсутствуют и сыплют ошибки.
local function is_vehicle_obj(o)
        if not o then return false end
        local ok_n, nm = pcall(o.name, o)
        if ok_n and type(nm) == "string" and string.find(string.lower(nm), "heli", 1, true) then
                return true
        end
        local ok_s, sec = pcall(o.section, o)
        return ok_s and type(sec) == "string" and string.find(string.lower(sec), "heli", 1, true) ~= nil
end

-- Выбор якоря по строке типа; глушитель - по активному оружию стрелка.
local function wpn_anchor(s_type, src)
        local stl = string.lower(s_type)
        if string.find(stl, "reload", 1, true) then return ANV_RELOAD, "reload" end
        if string.find(stl, "empty", 1, true) then return WPN_ANV_EMPTY, "empty" end
        if string.find(stl, "show", 1, true) or string.find(stl, "hide", 1, true) then
                return WPN_ANV_DRAW, "draw"
        end
        -- shoot/hit и неизвестные строки паков - полный выстрел.
        -- Глушитель читается только из оружия СТАЛКЕРА: active_item есть
        -- не у всех game object. У вертолётов/техники обращение к методу
        -- бросает ошибку биндинга ("CScriptGameObject: cannot access class
        -- member ...") - она печатается в лог игры даже под pcall (v2.5:
        -- лог боя с вертолётом был завален такими строками). Поэтому метод
        -- щупаем только у живых людей, технике - полный выстрел без проверки.
        if src then
                local ok_s, is_st = pcall(IsStalker, src)
                if ok_s and is_st then
                        local ok, item = pcall(src.active_item, src)
                        if ok and item and is_silenced(item) then return ANV_SHOT_SIL, "shot_sil" end
                end
        end
        return ANV_SHOT, "shot"
end

-- Источник 1: слух NPC (движок -> скрипт).
-- Реальная цепочка (xray-monolith): CScriptEntity::process_sound_callbacks
-- -> xr_hear.hear_callback -> SendScriptCallback("npc_on_hear_callback", ...).
-- Сигнатура (Anomaly 1.5.x, проверена по xr_hear.script):
--   npc_on_hear_callback(npc, who_id, s_type, sound_dist, sound_power, sound_position)
--     s_type     - СТРОКА: "WPN_shoot", "WPN_hit", "WPN_reload", "WPN_empty",
--                  "MST_step", "MST_attack", "MST_die", "ITM_drop" и т.д.;
--     sound_dist - КВАДРАТ расстояния слушатель<->источник (distance_to_sqr!);
--     sound_power- громкость у слушателя 0..1: движок уже ослабил звук
--                  линейно по расстоянию и стенам:
--                  Power = (1 - dist/max_ai_distance) * volume * occlusion.
--     sound_position - ТОЧКА ЗВУКА, и у оружия это НЕ стрелок: движок
--                  привязывает WPN_* к ПУЛЕ - в момент импульса слуха
--                  (каждые 0.5 с) это позиция снаряда/точка попадания.
--                  Проверено логом на GAMMA (v2.3): пули, летящие в игрока,
--                  давали pos в 1.7-3.5 м от игрока (стрелок в ~23 м),
--                  промахи - pos в 79-85 м ЗА игроком; WPN_shoot от паков
--                  без ogg-комментариев не приходит вовсе (game_type=0,
--                  Event_Propagade их не рассылает). Стрелок - who_id
--                  (источник звука), его живая позиция известна всегда.
-- Актёр слушателем не отчитывается (CActor::feel_sound_new не диспатчит
-- в Lua), поэтому мир видим "через уши ИИ"; свои звуки приходят, когда их
-- слышит кто-то из NPC (who_id == id игрока).
local function on_npc_hear(npc, who_id, s_type, dist, power, pos)
        local L = _G.sound_vision_log
        if not pos or pos.x == nil then
                if L and L.on() then
                        L.dbg("HEAR", "DROP: no position (s_type=%s who=%s)",
                                tostring(s_type), tostring(who_id))
                end
                return
        end
        local a = db.actor
        if not a then
                if L and L.on() and L.rate("hear_no_actor", 1000) then
                        L.dbg("HEAR", "DROP: actor not ready yet (s_type=%s)", tostring(s_type))
                end
                return
        end
        if who_id ~= nil and who_id == a:id() then
                -- источник звука - сам игрок
                if L and L.on() then
                        L.dbg("HEAR", "caught own sound: s_type=%s p=%s",
                                tostring(s_type),
                                type(power) == "number" and string.format("%.3f", power) or "?")
                end
                sound_vision_events.push_event(a:position().x, a:position().y, a:position().z,
                        "own", a:id(), nil, nil, true)
                return
        end
        local kind = sound_vision_classify.classify(s_type, who_id)
        -- Источник события: живой объект по who_id. Нужен для перекраски
        -- человеческих шагов/речи и якорения выстрела на стрелке.
        local src = nil
        if type(who_id) == "number" then
                local ok, o = pcall(function() return level.object_by_id(who_id) end)
                if ok then src = o end
                -- Техника (v2.5): событие от вертолёта обновляет наблюдение,
                -- по нему кадровая петля пульсирует кольцом полёта.
                if src and is_vehicle_obj(src) then
                        heli_watch[who_id] = time_global()
                end
        end
        -- Шаги и речь людей приходят с тем же префиксом MST_, что и у мутантов
        -- (классификатор видит "mst" раньше "step"/"talk"), и сталкер в бою
        -- светился фиолетовым «монстром» при каждом шаге. Люди -> жёлтые шаги
        -- и белая речь; мутанты (IsStalker = false) остаются фиолетовыми.
        if kind == "monster" and src and type(s_type) == "string" then
                local ok_h, human = pcall(IsStalker, src)
                if ok_h and human then
                        if s_type == "MST_step" then
                                kind = "step"
                        elseif s_type == "MST_talk" then
                                kind = "voice"
                        end
                end
        end
        -- Якорь WPN_*: СТРЕЛКОВ или ТОЧКУ ПОПАДАНИЯ (v2.3+v2.5+v2.6).
        -- Для WPN_* движок отдаёт pos = позиция ПУЛИ (см. блок сигнатуры выше):
        -- кольца вспыхивали у ног игрока (пуля рядом) или отклонялись гейтом
        -- (промах улетел за спину). Правила такие.
        --
        -- WPN_shoot - САМ ВЫСТРЕЛ, звук излучается у дульного среза: якорим
        -- к стрелку ВСЕГДА (v2.6), сравнения с пулей нет. Раньше якорение
        -- запускалось только при |стрелок - пуля| > 2 м, и события, где пуля
        -- ещё у ствола, уходили в перенос замера случайного ИИ-слушателя:
        -- если слушатель стоял у стрелка (dl ~ 3 м), обратный квадрат давил
        -- громкость до 0.98*(3/43)^2 = 0.004 < 0.02 - игрок видел вспышки и
        -- слышал стрельбу, а гейт резал кольца (лог 05.11: rejected на
        -- 42-44 м при loud 0.0039-0.0046). Глушитель читается у
        -- стрелка-сталкера (wpn_anchor); если who_id не разрешился, якорим
        -- в точку движка - для WPN_shoot это и есть ствол, но без проверки
        -- глушителя.
        --
        -- Остальные WPN_* (hit и т.п. - точка ПОПАДАНИЯ): считаются ОБА
        -- кандидата, кольцо получает слышимый:
        --   стрелок слышен (якорь типа звука на его дистанции, v2.4) ->
        --     кольцо на стрелке: направление на угрозу, стабильно от боя к бою;
        --   стрелок не слышен, а попадание у игрока слышно -> ВХОДЯЩИЙ ОГОНЬ
        --     (v2.5): кольцо остаётся в точке движка, громкость - перенос
        --     замера у ИИ-слушателя на игрока обратным квадратом. Случай
        --     вертолёта: стрелок за 300+ м якорь не проходит (0.004 < 0.02),
        --     а его пули крошат землю в 7-25 м от игрока (p до 0.76);
        --   не слышно ни того, ни другого -> кольцо на стрелке, гейт решит
        --     (как в v2.4). Гранаты/взрывы (строки без префикса WPN_) не
        --     трогаем - там точка взрыва полезнее, а сдвиг < 2 м - перекладки
        --     нет, замер громкости движка остаётся честным.
        local anch = pos          -- куда ставим кольцо
        local anch_from = nil     -- дистанция до точки движка (для строки журнала)
        local anch_anv, anch_anv_name = nil, nil
        local anch_im = nil       -- v2.5: громкость входящего огня (перенос замера)
        local anch_sh_d = nil     -- дистанция до стрелка (для строки журнала)
        -- dl нужен до якорения: кандидат «попадание» считается от замера у
        -- ИИ-слушателя
        local dl
        if type(power) == "number" and type(dist) == "number" and power > 0 then
                dl = math.sqrt(dist)                   -- в xr_hear: distance_to_sqr!
                if dl < 0.5 then dl = 0.5 end          -- слушатель вплотную
        end
        if kind == "weapon" and type(s_type) == "string"
                and string.find(string.lower(s_type), "wpn", 1, true) == 1 then
                local is_shot = string.find(string.lower(s_type), "shoot", 1, true) ~= nil
                local p0 = a:position()
                local px, py, pz = pos.x - p0.x, pos.y - p0.y, pos.z - p0.z
                local d_en = math.sqrt(px * px + py * py + pz * pz)
                local ok2, ep
                if src then ok2, ep = pcall(src.position, src) end
                if is_shot then
                        -- v2.6: выстрел якорится к стволу всегда (см. блок выше)
                        local anv, anv_name = wpn_anchor(s_type, src)
                        if ok2 and ep and ep.x then
                                local ex, ey, ez = ep.x - p0.x, ep.y - p0.y, ep.z - p0.z
                                anch = ep
                                anch_sh_d = math.sqrt(ex * ex + ey * ey + ez * ez)
                        else
                                -- стрелок не разрешился: точка движка и есть ствол
                                anch = pos
                        end
                        anch_from = d_en
                        anch_anv, anch_anv_name = anv, anv_name
                elseif src and ok2 and ep and ep.x then
                        local ex, ey, ez = ep.x - p0.x, ep.y - p0.y, ep.z - p0.z
                        local d_em = math.sqrt(ex * ex + ey * ey + ez * ez)
                        if math.abs(d_em - d_en) > 2 then
                                local anv, anv_name = wpn_anchor(s_type, src)
                                -- Кандидат «стрелок» (v2.4): громкость от якоря
                                -- типа звука на дистанции стрелка - стабильна,
                                -- не зависит от того, кто из NPC услышал пулю.
                                local loud_sh = anchor_loud(anv, d_em)
                                -- Кандидат «попадание» (v2.5): замер у ИИ-слушателя
                                -- пули переносится на игрока обратным квадратом
                                -- (децибельная модель расхождения фронта).
                                local loud_im
                                if dl then
                                        if d_en < 0.5 then
                                                loud_im = 1             -- попадание у самого игрока
                                        else
                                                loud_im = power * (dl / d_en) * (dl / d_en)
                                                if loud_im > 1 then loud_im = 1 end
                                        end
                                end
                                local cmod = sound_vision_config
                                local th = (cmod and cmod.mc and cmod.mc.loud_th) or 0.005 -- внутренний порог v2.7
                                if loud_sh >= th or not (loud_im and loud_im >= th) then
                                        -- стрелок слышим, либо попадание неслышимо:
                                        -- кольцо на стрелке (v2.4), гейт подтвердит
                                        anch = ep
                                        anch_from = d_en
                                        anch_sh_d = d_em
                                        anch_anv, anch_anv_name = anv, anv_name
                                else
                                        -- входящий огонь (v2.5): стрелок не слышен,
                                        -- попадание слышно - кольцо в точке движка
                                        anch = pos
                                        anch_from = d_en
                                        anch_sh_d = d_em
                                        anch_im = loud_im
                                end
                        end
                end
        end
        -- Зоны - не стрелки (v2.7): thermal-разряд аномалии приходит типом
        -- WPN_shoot (движок играет его звуком класса «выстрел»), и без
        -- перекраски аномалия рисовала красное кольцо атаки (лог 05.11:
        -- who=zone_mine_thermal_weak -> weapon, кольцо в 168 м). Звук WPN_*
        -- от того, кто не сталкер, не мутант и не техника, - это звук зоны:
        -- перекрашиваем в anomaly и переключаем ключ источника на ключ зоны,
        -- чтобы кольцо жило в одном экземпляре с её пульсами гула.
        local push_who = who_id
        if kind == "weapon" and src then
                local ok_zh, zh = pcall(IsStalker, src)
                local ok_zm, zm = pcall(IsMonster, src)
                if not (ok_zh and zh) and not (ok_zm and zm)
                        and not is_vehicle_obj(src) then
                        kind = "anomaly"
                        push_who = "anm" .. tostring(who_id)
                end
        end
        -- Восстановление громкости у игрока из якоря ИИ-наблюдения:
        -- на dl метрах от источника движок насчитал power; громкость падает
        -- обратным квадратом (дБ-модель расхождения фронта), значит у игрока
        -- (dp метров) она равна power * (dl/dp)^2. Ближе слушателя - громче,
        -- дальше - тише. Для входящего огня громкость уже посчитана переносом
        -- замера (anch_im); для якоренного выстрела - якорь типа звука (v2.4).
        local loud = nil
        local dp
        if dl then
                local p = a:position()
                local dx, dy, dz = anch.x - p.x, anch.y - p.y, anch.z - p.z
                dp = math.sqrt(dx * dx + dy * dy + dz * dz)
                if anch_im then
                        loud = anch_im                  -- входящий огонь: перенос замера
                elseif dp < 0.5 then
                        loud = 1                        -- источник у самого игрока
                elseif anch_anv then
                        loud = anchor_loud(anch_anv, dp) -- стабильный якорь выстрела
                else
                        loud = power * (dl / dp) * (dl / dp)
                        if loud > 1 then loud = 1 end
                end
        end
        -- Журнал (MCM: Отладка): событие слуха ПОЙМАНО; дальше решение очереди
        -- пишут GATE/QUEUE, вывод кольца - RENDER (см. sound_vision_log).
        if L and L.on() then
                local extra
                if anch_im then
                        extra = string.format(
                                " (incoming fire: shooter %.0fm below threshold -> impact ring, im=%.3f)",
                                anch_sh_d or 0, anch_im)
                elseif anch_from then
                        extra = string.format(" (anchored: pos %.0fm -> shooter %s, anv=%s)",
                                anch_from,
                                anch_sh_d and string.format("%.0fm", anch_sh_d) or "?",
                                tostring(anch_anv_name))
                end
                L.dbg("HEAR", "caught: s_type='%s' who=%s dl=%s p=%s -> %s loud=%s dp=%s%s",
                        tostring(s_type), L.who(who_id),
                        dl and string.format("%.1fm", dl) or "?",
                        type(power) == "number" and string.format("%.3f", power) or "?",
                        tostring(kind),
                        loud and string.format("%.3f", loud) or "n/a",
                        dp and string.format("%.1fm", dp) or "?",
                        extra or "")
        end
        -- push_event: fact=true (движковый факт - показываем без порога,
        -- v2.7); weapon-события идут с force=true - склейка по стрелку
        -- дедуплицирует копии от разных ИИ-слушателей, антиспам им не нужен.
        sound_vision_events.push_event(anch.x, anch.y, anch.z, kind, push_who,
                kind == "weapon", loud, true)
end

-- ---------------------------------------------------------------------------
-- Бонусный канал выстрелов NPC: колбэк моддед-экзешников, ЕСЛИ он на этой
-- сборке есть. В ванильном Anomaly 1.5.2 его нет (см. шапку v2.7), поэтому
-- гарантию даёт shot_poll (опрос боезапаса ниже), а колбэк лишь ускоряет
-- реакцию там, где движок сам сообщает о выстреле:
--   npc_on_weapon_shot_start(npc, weapon)   - на каждый выстрел сталкера;
--   npc_on_weapon_reload_start(npc, weapon) - начало перезарядки.
-- Актёру колбэк не приходит (диспатчит только CAI_Stalker, не CActor).
-- Громкость - от виртуальных якорей (единая модель с detect): без глушителя
-- выстрел слышен до ~246 м (потолок KIND_CAP.weapon = 250, v2.6), с
-- глушителем до ~77 м, перезарядка до ~40 м. Ключ источника - id стрелка:
-- каналы слуха, опроса боезапаса и колбэка используют одно пространство
-- ключей и в очереди склеиваются в живое кольцо, дублей нет.
-- ---------------------------------------------------------------------------
local function on_npc_shot_start(npc, weapon)
        if not sound_vision_config.mc.npc_shots then
                local L = _G.sound_vision_log
                if L and L.on() and L.rate("shot_off", 1000) then
                        L.dbg("SHOT", "DROP: channel disabled in MCM (npc_shots=off)")
                end
                return
        end
        if not npc then return end
        local ok, p = pcall(npc.position, npc)
        if not (ok and p and p.x) then
                local L = _G.sound_vision_log
                if L and L.on() then
                        L.dbg("SHOT", "DROP: no position npc=%s", tostring(npc.id and npc:id()))
                end
                return
        end
        local sil = is_silenced(weapon)
        local d = dist_to_actor(npc)
        local loud = anchor_loud(sil and ANV_SHOT_SIL or ANV_SHOT, d)
        local L = _G.sound_vision_log
        if L and L.on() then
                L.dbg("SHOT", "caught: npc=%s silenced=%s loud=%s d=%s",
                        L.who(npc:id()), tostring(sil),
                        string.format("%.3f", loud),
                        d and string.format("%.1fm", d) or "?")
        end
        sound_vision_events.push_event(p.x, p.y, p.z, "weapon", npc:id(), true, loud, true)
end

local function on_npc_reload_start(npc, weapon)
        if not sound_vision_config.mc.npc_shots then return end
        if not npc then return end
        local ok, p = pcall(npc.position, npc)
        if not (ok and p and p.x) then
                local L = _G.sound_vision_log
                if L and L.on() then
                        L.dbg("RELOAD", "DROP: no position npc=%s", tostring(npc.id and npc:id()))
                end
                return
        end
        local d = dist_to_actor(npc)
        local loud = anchor_loud(ANV_RELOAD, d)
        local L = _G.sound_vision_log
        if L and L.on() then
                L.dbg("RELOAD", "caught: npc=%s loud=%s d=%s",
                        L.who(npc:id()), string.format("%.3f", loud),
                        d and string.format("%.1fm", d) or "?")
        end
        sound_vision_events.push_event(p.x, p.y, p.z, "weapon", "rl" .. npc:id(), nil, loud, true)
end

-- Источник 2: колбэки аномалий (ванильные, см. callbacks-reference).
local function on_anomaly_activate(anomaly, activator)
        -- игрок/болт/NPC попали в зону: она шипит - немедленный импульс
        sound_vision_events.push_object(anomaly, "anomaly",
                function(an) return "anm" .. an:id() end, true,
                anchor_loud(ANV_ZONE_ACT, dist_to_actor(anomaly)))
end

local function on_actor_feel_anomaly(anomaly, flags)
        -- игрок вошёл в поле: зона шипит - немедленный импульс
        sound_vision_events.push_object(anomaly, "anomaly",
                function(an) return "anm" .. an:id() end, true,
                anchor_loud(ANV_ZONE_ACT, dist_to_actor(anomaly)))
end

-- ---------------------------------------------------------------------------
-- Источник 3: физика (ванильные колбэки; движение объектов ловит detect).
-- Аудио-данных колбэки не дают - громкость от виртуальных якорей выше.
-- Удар тем сильнее (amount из колбэка), тем громче:
-- p_v = 0.08 + 0.15 * amount, ограничено 0.08..0.4.
-- ---------------------------------------------------------------------------
local function on_physic_hit(obj, amount, direction, attacker, bone_id)
        if not sound_vision_config.mc.phys_enable then return end
        local pv = 0.08 + 0.15 * (tonumber(amount) or 0)
        if pv > 0.4 then pv = 0.4 end
        local loud = anchor_loud({ ANV_PHYS_HIT[1], pv }, dist_to_actor(obj))
        sound_vision_events.push_object(obj, "other",
                function(o) return "ph" .. o:id() end, nil, loud)
end

local function on_physic_use(obj, who)
        if not sound_vision_config.mc.phys_enable then return end
        local loud = anchor_loud(ANV_PHYS_HIT, dist_to_actor(obj))
        sound_vision_events.push_object(obj, "other",
                function(o) return "pu" .. o:id() end, nil, loud)
end

local function on_item_drop(obj)
        local loud = anchor_loud(ANV_PHYS_DROP, dist_to_actor(obj))
        sound_vision_events.push_object(obj, "other",
                function(o) return "dr" .. o:id() end, nil, loud)
end

-- ---------------------------------------------------------------------------
-- Пульс техники (v2.5): вертолёт под наблюдением раз в HELI_PULSE_MS пульсирует
-- оранжевым кольцом kind="vehicle" в своей живой позиции, пока свежи слуховые
-- события от его пуль (heli_watch). Громкость - от якоря винта ANV_HELI:
-- винт слышен очень далеко, поэтому у категории vehicle свой потолок дальности
-- в sound_vision_events (600 м вместо стрелковых 150 м).
-- ---------------------------------------------------------------------------
local function pulse_vehicles(now)
        if next(heli_watch) == nil then return end
        local a = db.actor
        if not a then return end
        if now - heli_pulse_t < HELI_PULSE_MS then return end
        heli_pulse_t = now
        local L = _G.sound_vision_log
        local dbg = (L and L.on()) and L.dbg or nil
        local ap = a:position()
        for id, t in pairs(heli_watch) do
                if now - t > HELI_TTL_MS then
                        heli_watch[id] = nil
                        if dbg then dbg("DETECT", "vehicle watch expired: who=%s", L.who(id)) end
                else
                        local ok, o = pcall(function() return level.object_by_id(id) end)
                        if not (ok and o) then
                                heli_watch[id] = nil
                                if dbg then dbg("DETECT", "vehicle gone: %s", tostring(id)) end
                        else
                                local okp, p = pcall(o.position, o)
                                if okp and p and p.x then
                                        local dx, dy, dz = p.x - ap.x, p.y - ap.y, p.z - ap.z
                                        local d = math.sqrt(dx * dx + dy * dy + dz * dz)
                                        if d <= HELI_MAX_D then
                                                local loud = anchor_loud(ANV_HELI, d)
                                                if dbg then
                                                        dbg("DETECT", "vehicle pulse: who=%s loud=%.3f d=%.1fm",
                                                                L.who(id), loud, d)
                                                end
                                                sound_vision_events.push_event(p.x, p.y, p.z,
                                                        "vehicle", "veh" .. id, true, loud)
                                        end
                                end
                        end
                end
        end
end

-- ---------------------------------------------------------------------------
-- Гарантированный канал выстрелов NPC (v2.7): ОПРОС БОЕЗАПАСА. Чистый Lua,
-- работает на любой сборке. Колбэка npc_on_weapon_shot_start в Anomaly 1.5.2
-- нет, а ИИ-рассылка звука выстрела зависит от ogg-комментариев оружия
-- (game_type = 0 - движок звук не рассылает) и наличия ИИ-слушателей рядом,
-- отсюда «то есть, то нет». Факт добываем сами: раз в WPN_POLL_MS у каждого
-- живого сталкера в радиусе WPN_POLL_D читаем active_item и счётчик
-- патронов get_ammo_total. Счётчик УПАЛ - был выстрел (одна пуля или
-- очередь за опрос - очередь склеит их в живое кольцо стрелка); ВЫРОС -
-- перезарядка (кольца нет); сменилось оружие - новая база без кольца.
-- Ключ источника - id стрелка: совпадает с каналами слуха и колбэка,
-- в очереди всё склеивается. Громкость - от якорей выстрела (глушитель
-- читается у оружия в руках).
-- ---------------------------------------------------------------------------
local WPN_POLL_MS = 200   -- период опроса боезапаса, мс
local WPN_POLL_D  = 250   -- потолок дальности weapon-колец (KIND_CAP.weapon)
local wpn_poll_t  = 0     -- таймер опроса
local wpn_clean_t = 0     -- таймер чистки осиротевших ключей
local wpn_ammo    = {}    -- [id NPC] = { wid = id оружия, ammo = патронов }

local function shot_poll(now)
        if not sound_vision_config.mc.npc_shots then return end
        if now - wpn_poll_t < WPN_POLL_MS then return end
        wpn_poll_t = now
        local a = db.actor
        if not a or not a:alive() then return end
        local ap = a:position()
        local L = _G.sound_vision_log
        local dbg, rate = nil, nil
        if L and L.on() then dbg, rate = L.dbg, L.rate end
        local maxd2 = WPN_POLL_D * WPN_POLL_D
        for id, st in pairs(db.storage) do
                local o = st and st.object
                if o and id ~= a:id() then
                        local ok_m, is_m = pcall(IsStalker, o)
                        if ok_m and is_m then
                                local ok_al, alive = pcall(o.alive, o)
                                if ok_al and alive then
                                        local ok_p, p = pcall(o.position, o)
                                        if ok_p and p and p.x then
                                                local dx, dy, dz = p.x - ap.x, p.y - ap.y, p.z - ap.z
                                                if dx * dx + dy * dy + dz * dz <= maxd2 then
                                                        local ok_i, item = pcall(o.active_item, o)
                                                        if ok_i and item then
                                                                local ok_s, sec = pcall(item.section, item)
                                                                if ok_s and type(sec) == "string"
                                                                        and string.find(sec, "wpn_", 1, true) == 1 then
                                                                        local ok_a, ammo = pcall(item.get_ammo_total, item)
                                                                        if ok_a and type(ammo) == "number" then
                                                                                local ok_w, wid = pcall(item.id, item)
                                                                                wid = ok_w and wid or 0
                                                                                local prev = wpn_ammo[id]
                                                                                if prev and prev.wid == wid
                                                                                        and ammo < prev.ammo then
                                                                                        local d = math.sqrt(dx * dx + dy * dy + dz * dz)
                                                                                        local loud = anchor_loud(
                                                                                                is_silenced(item) and ANV_SHOT_SIL or ANV_SHOT, d)
                                                                                        if dbg and rate("shot_" .. tostring(id), 500) then
                                                                                                dbg("SHOT", "poll: npc=%s ammo %d->%d loud=%.3f d=%.1fm",
                                                                                                        L.who(id), prev.ammo, ammo, loud, d)
                                                                                        end
                                                                                        sound_vision_events.push_event(p.x, p.y, p.z,
                                                                                                "weapon", id, true, loud, true)
                                                                                end
                                                                                wpn_ammo[id] = { wid = wid, ammo = ammo }
                                                                        elseif dbg and rate("shot_no_ammo_" .. tostring(id), 10000) then
                                                                                dbg("SHOT", "poll: get_ammo_total unavailable (npc=%s, weapon=%s)",
                                                                                        L.who(id), tostring(sec))
                                                                        end
                                                                else
                                                                        wpn_ammo[id] = nil       -- в руках не оружие (граната и т.п.)
                                                                end
                                                        else
                                                                wpn_ammo[id] = nil               -- руки пусты (перезарядка/смена)
                                                        end
                                                end
                                        end
                                else
                                        wpn_ammo[id] = nil                       -- погиб: база не нужна
                                end
                        end
                end
        end
        -- Чистка осиротевших ключей (деспавн, смена уровня).
        if now - wpn_clean_t >= 5000 then
                wpn_clean_t = now
                for wid in pairs(wpn_ammo) do
                        local st2 = db.storage[wid]
                        if not (st2 and st2.object) then wpn_ammo[wid] = nil end
                end
        end
end

-- ---------------------------------------------------------------------------
-- Игрока ЗАДЕЛО (v2.7): гарантированный маркер атаки в момент попадания.
-- Все прочие каналы могут молчать (ogg-метаданные, отсутствие слушателей),
-- но Hit у актёра движок вызывает всегда. Сигнатура (anomaly-modding-book):
--   actor_on_hit_callback(<actor>, <amount>, <vector>, <who>, <bone>),
-- who - объект, нанёсший удар: у выстрела это стрелок, у гранаты - граната.
-- Кольцо ставится в его живой позиции (громкость - якорь выстрела); если
-- стрелок дальше потолка 250 м, кольцо кладётся НА потолок в ту же сторону
-- (направление то же, а рендер всё равно прибивает дальние кольца к краю
-- экрана); не разрешился - у игрока. Свои попадания (падение, собственная
-- граната) не рисуем - серые «own»-кольца и так есть в канале слуха.
-- ---------------------------------------------------------------------------
local function on_actor_hit(_, amount, direction, who, bone)
        if not sound_vision_config.mc.npc_shots then return end
        local a = db.actor
        if not a then return end
        local ap = a:position()
        local x, y, z = ap.x, ap.y, ap.z
        local loud = 1
        local who_id = nil
        if who then
                local ok_id, wid = pcall(who.id, who)
                if ok_id and type(wid) == "number" and wid ~= a:id() then
                        who_id = wid
                end
                local ok_p, p = pcall(who.position, who)
                if ok_p and p and p.x then
                        local dx, dy, dz = p.x - ap.x, p.y - ap.y, p.z - ap.z
                        local d = math.sqrt(dx * dx + dy * dy + dz * dz)
                        if d > WPN_POLL_D and d > 0.5 then
                                -- стрелок дальше потолка: кольцо на потолке в ту же сторону
                                local k = WPN_POLL_D / d
                                x, y, z = ap.x + dx * k, ap.y + dy * k, ap.z + dz * k
                                loud = anchor_loud(ANV_SHOT, WPN_POLL_D)
                        else
                                x, y, z = p.x, p.y, p.z
                                loud = anchor_loud(ANV_SHOT, d)
                        end
                end
        end
        if who_id == nil then return end     -- своё падение / неразрешённый удар
        local L = _G.sound_vision_log
        if L and L.on() then
                L.dbg("SHOT", "actor hit: who=%s loud=%.3f", L.who(who_id), loud)
        end
        sound_vision_events.push_event(x, y, z, "weapon", who_id, true, loud, true)
end

-- ---------------------------------------------------------------------------
-- Источник 5: шаги самого игрока.
-- Ванильная сигнатура: (surface:string, power, is_crouching, flags).
-- На modded exes первый аргумент - объект, поэтому просто не реагируем
-- на не-строку (там свои механизмы, игроку свои шаги обычно не нужны).
-- show_own проверяется в очереди (can_show "own").
-- ---------------------------------------------------------------------------
local function on_footstep(surface, power, is_crouching, flags)
        if type(surface) ~= "string" then return end
        local a = db.actor
        if not a then return end
        local p = a:position()
        sound_vision_events.push_event(p.x, p.y, p.z, "own", a:id())
end

-- ---------------------------------------------------------------------------
-- Привязка кадров игры и системных событий.
-- ---------------------------------------------------------------------------

local function on_actor_update(_, dt)
        -- HUD создаём при первом кадре; create() идемпотентен
        sound_vision_render.create()
        if not sound_vision_config.mc.enabled then
                sound_vision_render.update()  -- гасим остатки колец
                return
        end
        local now = time_global()
        -- сначала детект (события этого кадра), потом отрисовка
        sound_vision_detect.update(now)
        shot_poll(now)        -- выстрелы NPC: опрос боезапаса (v2.7)
        pulse_vehicles(now)   -- техника: пульс кольца вертолёта (v2.5)
        sound_vision_render.update()
end

local function on_gui_show(gui_name, obj)
        sound_vision_render.set_hidden(true)   -- инвентарь/диалоги/карты поверх
end

local function on_gui_hide(gui_name, obj)
        sound_vision_render.set_hidden(false)
end

local function on_res_changed()
        -- UI-пространство сменилось: калибровка и сглаживание хранят старые
        -- UI-пиксели - сбрасываем, кольца не "доезжают" из несуществующих точек
        sound_vision_projection.reset()
        sound_vision_events.reset_smooth()
        sound_vision_render.hide_all()
end

local function on_actor_net_destroy()
        sound_vision_render.destroy()
end

local function on_load_state()
        -- новая загрузка: события эфемерны и не сохраняются - чистим всё
        sound_vision_events.clear_all()
        sound_vision_detect.clear()
        sound_vision_occlusion.clear()   -- кэш «за стеной» другой карты (v2.8)
        for k in pairs(heli_watch) do heli_watch[k] = nil end
        for k in pairs(wpn_ammo) do wpn_ammo[k] = nil end
        heli_pulse_t = 0
        sound_vision_render.hide_all()
        local L = _G.sound_vision_log
        if L then L.clear() end
        if L and L.on() then
                L.dbg("INIT", "load state: queue, detect, occlusion cache and log rate state cleared")
        end
end

-- ---------------------------------------------------------------------------
-- Регистрация (on_game_start вызывается автоматически в каждом скрипте).
-- Каждый RegisterScriptCallback под pcall: неизвестное имя не должно ломать
-- регистрацию остальных колбэков.
-- ---------------------------------------------------------------------------
local function safe_register(name, fn)
        local ok, err = pcall(RegisterScriptCallback, name, fn)
        -- Журнал (MCM: Отладка): на этой сборке колбэка нет - INIT прямо
        -- скажет об этом, и пропадание канала больше не "молчаливое".
        local L = _G.sound_vision_log
        if L and L.on() then
                if ok then
                        L.dbg("INIT", "callback '%s' registered", name)
                else
                        L.dbg("INIT", "ERROR: callback '%s' NOT available on this build: %s",
                                name, tostring(err))
                end
        end
end

function on_game_start()
        sound_vision_config.refresh_config()
        safe_register("actor_on_update", on_actor_update)
        safe_register("actor_on_first_update", sound_vision_config.refresh_config)
        safe_register("on_option_change", sound_vision_config.refresh_config)
        safe_register("npc_on_hear_callback", on_npc_hear)
        safe_register("npc_on_weapon_shot_start", on_npc_shot_start)     -- бонус экзешников
        safe_register("npc_on_weapon_reload_start", on_npc_reload_start) -- бонус экзешников
        safe_register("actor_on_hit_callback", on_actor_hit)
        safe_register("anomaly_on_before_activate", on_anomaly_activate)
        safe_register("actor_on_feeling_anomaly", on_actor_feel_anomaly)
        safe_register("physic_object_on_hit_callback", on_physic_hit)
        safe_register("physic_object_on_use_callback", on_physic_use)
        safe_register("actor_on_item_drop", on_item_drop)
        safe_register("actor_on_footstep", on_footstep)
        safe_register("GUI_on_show", on_gui_show)
        safe_register("GUI_on_hide", on_gui_hide)
        safe_register("on_screen_resolution_changed", on_res_changed)
        safe_register("actor_on_net_destroy", on_actor_net_destroy)
        safe_register("load_state", on_load_state)
        -- Итог старта: какие каналы живы и как настроен конвейер.
        local L = _G.sound_vision_log
        if L and L.on() then
                local mc = sound_vision_config.mc
                L.dbg("INIT", "started: enabled=%s by_loudness=%s max_dist=%dm npc_shots=%s (ammo-poll %dms/%dm + actor hit) show_own=%s vignette=%s(%.0f%% core %.0f%%/full %.0f%%) occlusion=%s(visible %.0f%% soft=%s +%d%%)",
                        tostring(mc.enabled), tostring(mc.by_loudness),
                        mc.max_dist, tostring(mc.npc_shots),
                        WPN_POLL_MS, WPN_POLL_D, tostring(mc.show_own),
                        tostring(mc.vign_on), mc.vign_min * 100,
                        mc.vign_core * 100, mc.vign_full * 100,
                        tostring(mc.occ_on), mc.occ_visible * 100,
                        tostring(mc.occ_soft), mc.occ_boost * 100)
        end
end

-- ---------------------------------------------------------------------------
-- Отладочный доступ (только чтение; для диагностики и тестов):
-- sound_vision_debug.events - текущая очередь событий, .classify(s_type) -
-- классификатор, .types() - реестр виденных типов, .push_event(...) -
-- принудительно создать событие.
-- Явный _G-экспорт: интерфейс доступен как обычный глобал из консоли/тестов.
-- ---------------------------------------------------------------------------
_G.sound_vision_debug = {
        events = sound_vision_events.list,
        push_event = sound_vision_events.push_event,
        classify = sound_vision_classify.classify,
        types    = sound_vision_classify.registry,
        refresh_config = sound_vision_config.refresh_config,
        -- v2.8: сводка окклюзии (доступность ray_pick, кэш, счётчик лучей):
        -- sound_vision_debug.occlusion_stats()
        occlusion_stats = sound_vision_occlusion.stats,
}
