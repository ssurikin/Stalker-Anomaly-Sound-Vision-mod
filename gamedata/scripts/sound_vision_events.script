-- ============================================================================
-- sound_vision_events: очередь событий звука
--
-- Ответственность (SRP): приём событий (проверка слышимости, категорий,
-- антиспама одного источника), расчёт масштаба кольца от дистанции,
-- хранение и жизненный цикл очереди (вытеснение старых, удаление мёртвых,
-- сбросы состояния). Ничего не знает о проекции и отрисовке.
--
-- Слышимость (v2.0). Событие может нести loud - рассчитанную громкость
-- у ИГРОКА (0..1). Модель движка (xray-monolith, IGame_Level::
-- SoundEvent_Register): Power = (1 - dist/max_ai_distance) * volume *
-- occlusion - линейное затухание с учётом глушимости стенами. Событие
-- от ИИ-слуха якорится наблюдением слушателя (dl, power), громкость у
-- игрока восстанавливается обратным квадратом (децибельная модель
-- расхождения фронта): pp = power * (dl/dp)^2. Такой переход не требует
-- калибровки отдельных источников: выстрел слышен издалека, шаги - нет,
-- потому что у них меньше исходная громкость, пришедшая из движка.
-- События опроса мира (шаги/физика/зоны без движковых данных) несут
-- громкость от виртуальных якорей (d_v, p_v) из sound_vision_detect.
-- Гейт слышимости: pp >= loud_th (MCM) и dp <= HEAR_CAP (защита от
-- межкартовых дистанций). Режим "по дистанции" (by_loudness=false)
-- сохранён как legacy: единый радиус cfg.max_dist.
--
-- Зависимости: sound_vision_config, sound_vision_classify (оба лениво -
-- грузятся позже по алфавиту, разрешаются при первом вызове).
--
-- Экспорт:
--   push_event(x, y, z, kind, who, force, loud) - событие в мировой точке
--   push_object(obj, kind, who, force, loud)    - событие в позиции объекта
--                                           (DRY: единая pcall-обёртка obj:position())
--   list                                  - живая очередь событий (НЕ мутировать
--                                           извне: порядок и поля живут здесь)
--   capacity()                            - ёмкость пула колец (XML ring_1..N)
--   max_events()                          - сколько событий видно одновременно
--   remove_dead()                         - вычистить события с dead=true
--   reset_smooth()                        - сброс состояния сглаживания рендера
--                                           (координаты в старых UI-пикселях,
--                                           напр. при смене разрешения)
--   clear_all()                           - полная очистка очереди и антиспама
--
-- Отладка (MCM -> Отладка -> Журнал отладки): каждая принятая копия события
-- пишется в лог строкой QUEUE (с id события), каждое отклонение - строкой
-- GATE с причиной: below threshold / too far / no loudness data / throttle /
-- category off / mod disabled. Журнал ведёт sound_vision_log.
-- ============================================================================

local POOL = 32        -- всего колец на экране (XML: ring_1..ring_32)
local HEAR_CAP = 150   -- предел показа по громкости, м: дальше аудио игрока уже
                       -- не различает источник, а обратный квадрат там неточен
local events = {}      -- {id,x,y,z,kind,scale,t,loud,d,dead, blend,last_sx,last_sy,pin_x,pin_y}
local throttle_t = {}  -- ключ источника -> time_global последнего события
local seq = 0          -- сквозной номер события (связывает QUEUE и RENDER в логе)

-- громкость для строки журнала: nil -> "n/a" (движковых данных не было)
local function fmt_loud(loud)
        return loud and string.format("%.3f", loud) or "n/a"
end

-- Ленивая инициализация. Кэшировать ссылки безопасно: mc живёт одной
-- таблицей всю сессию (refresh_config меняет только поля).
local cfg, can_show
local function init()
        if not cfg then
                local cmod = _G.sound_vision_config
                local kmod = _G.sound_vision_classify
                if cmod and kmod then
                        cfg = cmod.mc
                        can_show = kmod.can_show
                end
        end
end

local function max_events()
        init()
        if not cfg then return 0 end
        return math.floor(POOL / cfg.rings)
end

-- Добавить событие: мировая точка, категория, ключ источника (для антиспама),
-- force - пропустить антиспам (точные активации: шипение зоны и т.п.),
-- loud - громкость у игрока 0..1 (nil = без движковых данных: тогда
-- действует legacy-гейт по дистанции, как в v1.x).
-- Каждое решение пишется в журнал (GATE - отказ с причиной, QUEUE - приём),
-- частотный фильтр не даёт затопить лог повторами одного источника.
local function push_event(x, y, z, kind, who, force, loud)
        init()
        if not cfg or not can_show then return end
        local L = _G.sound_vision_log
        local dbg, rate = nil, nil
        if L and L.on() then dbg, rate = L.dbg, L.rate end
        if not cfg.enabled then
                if dbg and rate("disabled", 1000) then
                        dbg("GATE", "rejected (mod disabled): kind=%s who=%s",
                                tostring(kind), tostring(who))
                end
                return
        end
        if not can_show(kind) then
                if dbg and rate("cat_" .. tostring(kind), 1000) then
                        dbg("GATE", "rejected (category off): kind=%s who=%s loud=%s",
                                tostring(kind), tostring(who), fmt_loud(loud))
                end
                return
        end
        local a = db.actor
        if not a then
                if dbg and rate("no_actor", 1000) then
                        dbg("GATE", "rejected (actor not ready): kind=%s who=%s",
                                tostring(kind), tostring(who))
                end
                return
        end
        local ap = a:position()
        local dx, dy, dz = x - ap.x, y - ap.y, z - ap.z
        local d2 = dx * dx + dy * dy + dz * dz
        local d = math.sqrt(d2)
        -- Гейт слышимости. loud считается отправителем (движковые события -
        -- через якорь ИИ-наблюдения, опрос мира - через виртуальные якоря).
        if cfg.by_loudness and loud ~= nil then
                if loud < cfg.loud_th then
                        if dbg and rate("th_" .. tostring(who or kind), 1000) then
                                dbg("GATE", "rejected (below threshold): kind=%s who=%s loud=%.4f < %.4f d=%.1fm",
                                        tostring(kind), tostring(who), loud, cfg.loud_th, d)
                        end
                        return
                end
                if d > HEAR_CAP then
                        if dbg and rate("cap_" .. tostring(who or kind), 1000) then
                                dbg("GATE", "rejected (too far): kind=%s who=%s d=%.0fm > %dm loud=%.3f",
                                        tostring(kind), tostring(who), d, HEAR_CAP, loud)
                        end
                        return
                end
        else
                -- legacy: единый радиус (режим "по дистанции" либо событие
                -- без громкости - движковых данных не было)
                if d > cfg.max_dist then
                        if dbg and rate("dist_" .. tostring(who or kind), 1000) then
                                dbg("GATE", "rejected (%s d=%.0fm > %dm): kind=%s who=%s loud=%s",
                                        loud == nil and "no loudness data, legacy radius" or "legacy radius",
                                        d, cfg.max_dist, tostring(kind), tostring(who), fmt_loud(loud))
                        end
                        return
                end
        end
        local now = time_global()
        if not force then
                local key = who or 0
                local lt = throttle_t[key]
                if lt and (now - lt) < cfg.throttle * 1000 then
                        if dbg and rate("thr_" .. tostring(key), 1000) then
                                dbg("GATE", "rejected (throttle, %.2fs < %.2fs): kind=%s who=%s loud=%s d=%.1fm",
                                        (now - lt) / 1000, cfg.throttle, tostring(kind),
                                        tostring(who), fmt_loud(loud), d)
                        end
                        return
                end
                throttle_t[key] = now
        end
        -- масштаб размера: чем дальше источник, тем меньше кольцо (дистанция
        -- управляет ТОЛЬКО визуалом: размер и прозрачность, не слышимостью)
        local scale = cfg.ref_dist / math.max(d, 0.5)
        if scale > 1 then scale = 1 end
        if scale < cfg.min_frac then scale = cfg.min_frac end
        local n = #events
        local cap = max_events()
        if n >= cap then
                if dbg then
                        dbg("QUEUE", "evicted oldest id=%s (queue full %d/%d)",
                                tostring(events[1].id), n, cap)
                end
                table.remove(events, 1) -- вытесняем самое старое
                n = n - 1
        end
        seq = seq + 1
        events[n + 1] = { id = seq, x = x, y = y, z = z, kind = kind, scale = scale,
                t = now, loud = loud, d = d, dead = false }
        if dbg then
                dbg("QUEUE", "accepted id=%d kind=%s who=%s loud=%s d=%.1fm (queue %d/%d)",
                        seq, tostring(kind), tostring(who), fmt_loud(loud), d, n + 1, cap)
        end
end

-- Событие в позиции игрового объекта. Единая обёртка вместо пяти копий
-- "local ok, p = pcall(obj.position, obj); if ok and p and p.x then ...".
-- who - строка/число ИЛИ функция(obj) -> ключ: ленивый ключ вычисляется
-- только после успешного pcall(position), ошибка в нём не роняет колбэк
-- (точная семантика прежних обработчиков).
local function push_object(obj, kind, who, force, loud)
        if not obj then return end
        local ok, p = pcall(obj.position, obj)
        if ok and p and p.x then
                local key = who
                if type(who) == "function" then
                        local ok_key, k = pcall(who, obj)
                        if not ok_key then return end
                        key = k
                end
                push_event(p.x, p.y, p.z, kind, key, force, loud)
        end
end

-- Удалить мёртвые события (in-place; вызывает рендер после кадра).
local function remove_dead()
        local w = 0
        for i = 1, #events do
                if not events[i].dead then
                        w = w + 1
                        events[w] = events[i]
                end
        end
        for i = #events, w + 1, -1 do
                events[i] = nil
        end
end

-- Сброс состояния сглаживания рендера (blend/якоря хранятся в UI-пикселях
-- и становятся неверными при смене разрешения).
local function reset_smooth()
        for i = 1, #events do
                local e = events[i]
                e.blend, e.last_sx, e.last_sy, e.pin_x, e.pin_y = nil, nil, nil, nil, nil
        end
end

-- Полная очистка: новая загрузка игры (события эфемерны и не сохраняются).
local function clear_all()
        for i = 1, #events do events[i] = nil end
        for k in pairs(throttle_t) do throttle_t[k] = nil end
        seq = 0
end

-- ============================================================================
-- Экспорт модуля
-- ============================================================================
_G.sound_vision_events = {
        push_event = push_event,
        push_object = push_object,
        list = events,
        capacity = function() return POOL end,
        max_events = max_events,
        remove_dead = remove_dead,
        reset_smooth = reset_smooth,
        clear_all = clear_all,
}
