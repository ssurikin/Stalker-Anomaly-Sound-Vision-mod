-- ============================================================================
-- sound_vision_config: конфигурация мода Sound Vision
--
-- Ответственность (SRP): единственная точка хранения и обновления настроек.
-- Кэширует значения из MCM (sound_vision_mcm.get_config) в таблице mc;
-- без установленного MCM используются значения по умолчанию.
--
-- Зависимости: sound_vision_mcm (разрешается лениво, в момент вызова
-- refresh_config: обращение к глобалу само загружает нужный скрипт).
--
-- Экспорт (паттерн Twitch Integration: явная таблица в _G, движок лениво
-- загружает скрипт при первом обращении к имени модуля из любого файла):
--   mc             - кэш настроек; потребители читают напрямую (горячий путь
--                    рендера), МЕНЯТЬ ИЗВНЕ ЗАПРЕЩЕНО - только refresh_config
--                    и toggle_enabled
--   refresh_config - перечитать все настройки из MCM
--   toggle_enabled - переключить показ ореолов хоткеем (v2.9.2)
--
-- Вызывают: sound_vision (on_game_start / actor_on_first_update /
-- on_option_change / on_key_press), sound_vision_mcm (on_option_change).
-- ============================================================================

-- Кэш значений. Ключи совпадают с опциями MCM (см. sound_vision_mcm.script).
local mc = {
        enabled     = true,   -- мод включён
        show_own    = false,  -- показывать собственные звуки игрока
        by_loudness = true,   -- слышимость по громкости (как в игре), иначе по дистанции
        loud_th     = 0.010, -- порог слышимости (v2.8.2, MCM «Слышимость»):
                             -- громкость у игрока, ниже которой кольцо не
                             -- рисуется; 0 = показывать всё. На weapon-метки
                             -- (выстрелы/перезарядка/попадание) не действует
        anchor_th   = 0.005, -- ВНУТРЕННИЙ: порог «стрелок слышен» при выборе
                             -- якоря слуха (стрелок vs точка попадания)
        max_dist    = 45,     -- радиус опроса мира / лимит в режиме "по дистанции", м
        lifetime    = 1.2,    -- время жизни волны, сек
        throttle    = 0.3,    -- пауза между волнами одного источника, сек
        size_px     = 96,     -- размер кольца (виртуальные пиксели HUD)
        ref_dist    = 8,      -- базовое расстояние полного размера, м
        min_frac    = 0.12,   -- минимальный размер дальнего звука (доля)
        rings       = 2,      -- волн на один звук (1-3)
        opacity     = 0.85,   -- яркость (доля)
        cat_weapon  = true,   -- категория: выстрелы и оружие
        cat_voice   = true,   -- категория: голос и речь
        cat_step    = true,   -- категория: шаги и движение
        cat_monster = true,   -- категория: мутанты
        cat_anomaly = true,   -- категория: аномалии (гул, шипение)
        cat_other   = true,   -- категория: физика и прочее
        anm_pulse   = 4,      -- пауза между пульсами гула зоны, сек
        phys_enable = true,   -- физика: следить за движением объектов
        phys_sens   = 0.12,   -- порог смещения "объект движется", м
        npc_shots   = true,   -- гарантированный канал выстрелов: опрос боезапаса
                              -- + кольцо при попадании в игрока
        expl_boost  = true,   -- взрывы крупными кольцами (v2.9): не уменьшаются
                              -- с расстоянием, громкость добавляет размер
        vign_on     = true,   -- виньетка: гасить индикацию в центре экрана (v2.8)
        vign_min    = 0.10,   -- остаточная яркость в самом центре (доля текущей)
        vign_core   = 0.50,   -- радиус ядра виньетки (доля пути центр->край)
        vign_full   = 1.00,   -- радиус полной яркости (доля пути центр->край)
        occ_on      = true,   -- учёт перекрытия: виден напрямую / за стеной (v2.8)
        occ_visible = 0.40,   -- яркость ореола ВИДИМОГО источника (доля)
        occ_wall    = 0.70,   -- яркость источника ЗА СТЕНОЙ (доля) - ключевая
                              -- информация для слабослышащих: ярче видимого
        occ_soft    = true,   -- за стеной: размытая текстура ореола
        occ_boost   = 1.30,   -- за стеной: раздувание размытого ореола (доля)
        occ_vign    = false,  -- гасить источник за стеной виньеткой центра
                              -- (по умолчанию НЕТ - глухой должен видеть)
        dbg_types   = false,  -- журнал новых типов звуков в лог игры
        debug_logs  = false,  -- отладочный журнал конвейера (MCM: Отладка)
}

-- Перечитать настройки из MCM. Колбэк on_option_change приходит во все
-- *_mcm.script при применении настроек; движок вызывает на старте игры.

-- ---------------------------------------------------------------------------
-- Хоткей показа/скрытия ореолов (v2.9.2, MCM «Общие» ->
-- «Sound Vision: показывать/скрывать ореолы (клавиша)»). Переопределение
-- времени выполнения: nil - действует галочка «Включить мод» из MCM;
-- true/false - состояние, выставленное нажатием клавиши (toggle_enabled).
-- Переживает refresh_config (перезагрузка сохранения или применение посторонних
-- настроек MCM не возвращает ореолы, которые игрок только что спрятал), но
-- сбрасывается, когда игрок сам меняет галочку в MCM - у неё приоритет.
-- Новая игра/перезапуск (свежее Lua-состояние) - снова по галочке.
-- ---------------------------------------------------------------------------
local hotkey_override  = nil
local mcm_enabled_prev = nil

local function refresh_config()
        -- Хоткей-семантика: если галочку «Включить мод» поменяли в MCM - её
        -- значение авторитетно, переопределение клавишей сбрасываем. Если не
        -- меняли - переопределение (если есть) сильнее галочки.
        local mcm_enabled = sound_vision_mcm.get_config("enabled") ~= false
        if mcm_enabled_prev ~= nil and mcm_enabled ~= mcm_enabled_prev then
                hotkey_override = nil
        end
        mcm_enabled_prev = mcm_enabled
        mc.enabled = mcm_enabled
        if hotkey_override ~= nil then mc.enabled = hotkey_override end
        mc.show_own    = sound_vision_mcm.get_config("show_own") == true
        mc.by_loudness = sound_vision_mcm.get_config("by_loudness") ~= false
        -- Порог слышимости (v2.8.2): в MCM - в тысячных долях (промилле),
        -- 0 = показывать всё, по умолчанию 10. Внутренний порог якоря
        -- слуха (anchor_th) от настройки игрока не зависит.
        mc.loud_th     = math.max(0, math.min(100,
                tonumber(sound_vision_mcm.get_config("loud_th")) or 10)) / 1000
        mc.anchor_th   = 0.005
        mc.max_dist    = tonumber(sound_vision_mcm.get_config("max_dist")) or 45
        mc.lifetime    = tonumber(sound_vision_mcm.get_config("lifetime")) or 1.2
        mc.throttle    = tonumber(sound_vision_mcm.get_config("throttle")) or 0.3
        mc.size_px     = tonumber(sound_vision_mcm.get_config("size_px")) or 96
        mc.ref_dist    = math.max(0.5, tonumber(sound_vision_mcm.get_config("ref_dist")) or 8)
        mc.min_frac    = (tonumber(sound_vision_mcm.get_config("min_frac")) or 12) / 100
        mc.rings       = math.max(1, math.min(3, math.floor(tonumber(sound_vision_mcm.get_config("rings")) or 2)))
        mc.opacity     = (tonumber(sound_vision_mcm.get_config("opacity")) or 85) / 100
        mc.cat_weapon  = sound_vision_mcm.get_config("cat_weapon") ~= false
        mc.cat_voice   = sound_vision_mcm.get_config("cat_voice") ~= false
        mc.cat_step    = sound_vision_mcm.get_config("cat_step") ~= false
        mc.cat_monster = sound_vision_mcm.get_config("cat_monster") ~= false
        mc.cat_anomaly = sound_vision_mcm.get_config("cat_anomaly") ~= false
        mc.cat_other   = sound_vision_mcm.get_config("cat_other") ~= false
        mc.anm_pulse   = math.max(2, tonumber(sound_vision_mcm.get_config("anm_pulse")) or 4)
        mc.phys_enable = sound_vision_mcm.get_config("phys_enable") ~= false
        mc.phys_sens   = math.max(0.02, (tonumber(sound_vision_mcm.get_config("phys_sens")) or 12) / 100)
        mc.npc_shots   = sound_vision_mcm.get_config("npc_shots") ~= false
        -- Взрывы (v2.9): по умолчанию кольцо взрыва полное и крупное.
        -- Выключение возвращает взрывам обычное поведение (уменьшение с
        -- расстоянием); сами взрывы показываются в любом случае.
        mc.expl_boost  = sound_vision_mcm.get_config("expl_boost") ~= false
        -- Виньетка центра и учёт перекрытия (v2.8): в MCM значения хранятся
        -- в процентах, здесь - в долях. Границы виньетки согласованы: ядро
        -- не дальше полной яркости.
        mc.vign_on     = sound_vision_mcm.get_config("vign_on") ~= false
        mc.vign_min    = math.max(0, math.min(0.9,
                (tonumber(sound_vision_mcm.get_config("vign_min")) or 10) / 100))
        mc.vign_core   = math.max(0.05, math.min(0.95,
                (tonumber(sound_vision_mcm.get_config("vign_core")) or 50) / 100))
        mc.vign_full   = math.max(0.1, math.min(1.5,
                (tonumber(sound_vision_mcm.get_config("vign_full")) or 100) / 100))
        mc.occ_on      = sound_vision_mcm.get_config("occ_on") ~= false
        mc.occ_visible = math.max(0.05, math.min(1,
                (tonumber(sound_vision_mcm.get_config("occ_visible")) or 40) / 100))
        -- Яркость источника ЗА СТЕНОЙ (v2.8.1): 0-100% по спецификации MCM.
        -- Это главный канал информации для слабослышащих, поэтому по умолчанию
        -- ярче видимого источника (70 против 40).
        mc.occ_wall    = math.max(0, math.min(1,
                (tonumber(sound_vision_mcm.get_config("occ_wall")) or 70) / 100))
        mc.occ_soft    = sound_vision_mcm.get_config("occ_soft") ~= false
        mc.occ_boost   = math.max(1, math.min(2,
                (tonumber(sound_vision_mcm.get_config("occ_boost")) or 130) / 100))
        -- Гасить ли источник за стеной виньеткой центра (v2.8.1). По умолчанию
        -- НЕТ: слабослышащему источник за стеной нужнее всего, виньетка ему не
        -- помеха. Включение возвращает поведение v2.8.
        mc.occ_vign    = sound_vision_mcm.get_config("occ_vign") == true
        mc.dbg_types   = sound_vision_mcm.get_config("dbg_types") == true
        mc.debug_logs  = sound_vision_mcm.get_config("debug_logs") == true
        -- Журнал (MCM: Отладка): настройки перечитаны. Строка полезна как
        -- маркер "настройки применились" в потоке отладочных строк.
        local L = _G.sound_vision_log
        if L and L.on() then
                L.dbg("CONFIG", "refresh: enabled=%s by_loudness=%s loud_th=%.3f anchor=%.3f max_dist=%dm npc_shots=%s expl_boost=%s show_own=%s vignette=%s min=%.2f core=%.2f full=%.2f occlusion=%s visible=%.2f wall=%.2f soft=%s boost=%.2f wall_vignette=%s debug=%s",
                        tostring(mc.enabled), tostring(mc.by_loudness), mc.loud_th,
                        mc.anchor_th, mc.max_dist, tostring(mc.npc_shots), tostring(mc.expl_boost),
                        tostring(mc.show_own),
                        tostring(mc.vign_on), mc.vign_min, mc.vign_core, mc.vign_full,
                        tostring(mc.occ_on), mc.occ_visible, mc.occ_wall, tostring(mc.occ_soft),
                        mc.occ_boost, tostring(mc.occ_vign), tostring(mc.debug_logs))
        end
end

-- Переключить показ ореолов клавишей (v2.9.2): тот же флаг «мод вкл/выкл»,
-- что у галочки «Включить мод» в MCM, только прямо в игре. Возвращает новое
-- состояние (true - ореолы показываются). Вызывается из sound_vision
-- (on_key_press).
local function toggle_enabled()
        local mcm_enabled = sound_vision_mcm.get_config("enabled") ~= false
        -- ВАЖНО: не "(override ~= nil) and override or mcm_enabled" - при
        -- override=false эта конструкция проваливается в mcm_enabled (классическая
        -- lua-ловушка "and-or"), и второй нажим не возвращает ореолы.
        local cur = mcm_enabled
        if hotkey_override ~= nil then cur = hotkey_override end
        hotkey_override = not cur
        mc.enabled = hotkey_override
        local L = _G.sound_vision_log
        if L and L.on() then
                L.dbg("CONFIG", "hotkey toggle: enabled=%s (mcm checkbox=%s)",
                        tostring(mc.enabled), tostring(mcm_enabled))
        end
        return mc.enabled
end

-- ============================================================================
-- Экспорт модуля
-- ============================================================================
_G.sound_vision_config = {
        mc             = mc,
        refresh_config = refresh_config,
        toggle_enabled = toggle_enabled,
}
