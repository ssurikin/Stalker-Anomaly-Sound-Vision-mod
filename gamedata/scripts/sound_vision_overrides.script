-- ============================================================================
-- sound_vision_overrides: ручной пул типов звуков для Sound Vision
--
-- Зачем: модпаки (GAMMA, EFP и любые сборки) присылают свои строки типов
-- звуков; классификатор мода распознаёт их эвристикой по подстрокам, но
-- экзотику можно указать здесь явно. Файл правится под любую сборку без
-- изменения кода мода - пул типов расширяется на месте.
--
-- Как собрать свой список:
--   1) включите в MCM (раздел "Отладка") опцию "Журнал типов звуков";
--   2) поиграйте: постреляйте, перезаряжайтесь, бегайте - что угодно;
--   3) откройте лог игры (appdata\logs\xray_<имя>.log) и найдите строки
--      вида: [sound_vision][TYPES] s_type '...' -> <категория>;
--   4) впишите строку, которую хочется перекрасить, в map ниже.
--
-- Категории: "weapon" (красный), "voice" (белый), "step" (жёлтый),
-- "monster" (фиолетовый), "anomaly" (бирюзовый), "other" (синий).
-- Ключ - строка типа из журнала (регистр букв не важен). Переопределение
-- имеет высший приоритет: применяется раньше эвристики классификатора.
-- ============================================================================

sound_vision_overrides = {
        map = {
                -- Примеры (раскомментировать и поправить под свою сборку):
                -- ["WPN_shoot"]          = "weapon",
                -- ["MST_step"]           = "monster",
                -- ["my_pack_custom_fire"] = "weapon",
        },
}
