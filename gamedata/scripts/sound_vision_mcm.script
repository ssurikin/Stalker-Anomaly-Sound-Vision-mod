-- ============================================================================
-- sound_vision_mcm: интеграция с MCM (Mod Configuration Menu)
-- Работает и без установленного MCM: тогда используются значения по умолчанию.
--
-- Ответственность (SRP): только дерево настроек и единая точка их чтения.
-- Кэширование и хранение значений - в sound_vision_config.
--
-- Структура дерева - по официальной документации MCM
-- (github.com/RAX-Anomaly/Anomaly-Mod-Configuration-Menu) и по образцу
-- рабочих модов (Twitch Integration):
--   - ВЕРХНИЙ уровень БЕЗ поля sh: он содержит подгруппы-разделы.
--     (sh=true на верхнем уровне при наличии подгрупп ломает дерево:
--     MCM считает подгруппы "плоскими опциями" и рисует пустую страницу.)
--   - Каждая подгруппа: id, sh = true, text, gr = {опции}.
--   - Подписи опций MCM берёт из configs/text/<lang>/ui_st_sound_vision.xml
--     по ключам ui_mcm_sound_vision_<раздел>_<опция> (+ _desc).
-- ============================================================================
local defaults = {
        enabled     = true,    -- мод включён
        show_own    = false,   -- показывать собственные звуки игрока
        by_loudness = true,    -- слышимость по громкости (как в игре)
        max_dist    = 45,      -- радиус опроса мира / лимит в режиме "по дистанции", м
        lifetime    = 1.2,     -- время жизни волны, сек
        throttle    = 0.3,     -- пауза между волнами одного источника, сек
        size_px     = 96,      -- размер кольца (виртуальные пиксели HUD)
        ref_dist    = 8,       -- базовое расстояние полного размера, м
        min_frac    = 12,      -- минимальный размер дальнего звука, % (0.12)
        rings       = 2,       -- волн на один звук (1-3)
        opacity     = 85,      -- яркость, % (0.85)
        cat_weapon  = true,    -- категория: выстрелы и оружие
        cat_voice   = true,    -- категория: голос и речь
        cat_step    = true,    -- категория: шаги и движение
        cat_monster = true,    -- категория: мутанты
        cat_anomaly = true,    -- категория: аномалии (гул, шипение)
        cat_other   = true,    -- категория: физика и прочее
        anm_pulse   = 4,       -- пауза между пульсами гула аномалий, сек
        phys_enable = true,    -- физика: следить за движением объектов
        phys_sens   = 12,      -- порог смещения "объект движется", см
        npc_shots   = true,    -- гарантированный канал выстрелов: опрос боезапаса
                               -- + кольцо при попадании в игрока
        vign_on     = true,    -- виньетка: гасить индикацию в центре экрана (v2.8)
        vign_min    = 10,      -- остаточная яркость в самом центре, % (0.10)
        vign_core   = 50,      -- радиус ядра виньетки, % пути центр->край (0.50)
        vign_full   = 100,     -- радиус полной яркости, % пути центр->край (1.00)
        occ_on      = true,    -- учёт перекрытия: виден напрямую / за стеной (v2.8)
        occ_visible = 40,      -- яркость ореола видимого источника, % (0.40)
        occ_wall    = 70,      -- яркость источника ЗА СТЕНОЙ, % (0.70) - ключевая
                               -- информация для слабослышащих: обычный человек
                               -- слышит врага за стеной, глухой должен видеть
        occ_soft    = true,    -- за стеной: размытая текстура ореола
        occ_boost   = 130,     -- за стеной: раздувание размытого ореола, % (1.30)
        occ_vign    = false,   -- гасить источник за стеной виньеткой центра
                               -- (по умолчанию НЕТ: виньетка не должна прятать
                               -- самое важное для глухого игрока)
        dbg_types   = false,   -- журнал новых типов звуков в лог игры
        debug_logs  = false,   -- отладочный журнал конвейера (HEAR/GATE/QUEUE/RENDER)
}

-- имя опции -> группа в дереве MCM (нужно для пути ui_mcm.get)
local opt_group = {
        enabled     = "general",
        show_own    = "general",
        by_loudness = "hearing",
        max_dist    = "general",
        lifetime    = "general",
        throttle    = "general",
        size_px     = "size",
        ref_dist    = "size",
        min_frac    = "size",
        rings       = "size",
        opacity     = "size",
        cat_weapon  = "categories",
        cat_voice   = "categories",
        cat_step    = "categories",
        cat_monster = "categories",
        cat_anomaly = "categories",
        cat_other   = "categories",
        anm_pulse   = "detect",
        phys_enable = "detect",
        phys_sens   = "detect",
        npc_shots   = "detect",
        vign_on     = "vignette",
        vign_min    = "vignette",
        vign_core   = "vignette",
        vign_full   = "vignette",
        occ_on      = "occlusion",
        occ_visible = "occlusion",
        occ_wall    = "occlusion",
        occ_soft    = "occlusion",
        occ_boost   = "occlusion",
        occ_vign    = "occlusion",
        dbg_types   = "debug",
        debug_logs  = "debug",
}

-- Единая точка чтения настроек: из MCM, а если его нет - из defaults.
function get_config(key)
        if ui_mcm then
                local g = opt_group[key]
                if g then
                        local ok, v = pcall(ui_mcm.get, "sound_vision/" .. g .. "/" .. key)
                        if ok and v ~= nil then
                                return v
                        end
                end
        end
        return defaults[key]
end

-- MCM вызывает on_option_change во всех *_mcm.script при применении настроек
-- (тот же колбэк, что и у ui_options). Обновляем кэш значений в конфиг-модуле.
function on_option_change()
        if sound_vision_config and sound_vision_config.refresh_config then
                pcall(sound_vision_config.refresh_config)
        end
end

function on_mcm_load()
        local op = {
                id = "sound_vision",
                text = "ui_mcm_sound_vision",
                gr = {
                        { id = "general", sh = true, text = "ui_mcm_sound_vision_section_general", gr = {
                                { id = "title_general", type = "title", text = "ui_mcm_sound_vision_section_general" },
                                { id = "enabled",  type = "check", val = 1, def = defaults.enabled },
                                { id = "show_own", type = "check", val = 1, def = defaults.show_own },
                                { id = "max_dist", type = "track", val = 2,
                                        def = defaults.max_dist, min = 5, max = 100, step = 1 },
                                { id = "lifetime", type = "track", val = 2,
                                        def = defaults.lifetime, min = 0.4, max = 3.0, step = 0.1 },
                                { id = "throttle", type = "track", val = 2,
                                        def = defaults.throttle, min = 0.1, max = 1.0, step = 0.05 },
                        } },
                        { id = "hearing", sh = true, text = "ui_mcm_sound_vision_section_hearing", gr = {
                                { id = "title_hearing", type = "title", text = "ui_mcm_sound_vision_section_hearing" },
                                { id = "by_loudness", type = "check", val = 1, def = defaults.by_loudness },
                                -- loud_th удалена (v2.7): гейта слышимости больше нет,
                                -- показывается всё, что поймали каналы
                        } },
                        { id = "size", sh = true, text = "ui_mcm_sound_vision_section_size", gr = {
                                { id = "title_size", type = "title", text = "ui_mcm_sound_vision_section_size" },
                                { id = "size_px",  type = "track", val = 2,
                                        def = defaults.size_px, min = 24, max = 200, step = 2 },
                                { id = "ref_dist", type = "track", val = 2,
                                        def = defaults.ref_dist, min = 2, max = 30, step = 1 },
                                { id = "min_frac", type = "track", val = 2,
                                        def = defaults.min_frac, min = 5, max = 50, step = 1 },
                                { id = "rings",    type = "track", val = 2,
                                        def = defaults.rings, min = 1, max = 3, step = 1 },
                                { id = "opacity",  type = "track", val = 2,
                                        def = defaults.opacity, min = 20, max = 100, step = 5 },
                        } },
                        { id = "categories", sh = true, text = "ui_mcm_sound_vision_section_categories", gr = {
                                { id = "title_categories", type = "title", text = "ui_mcm_sound_vision_section_categories" },
                                { id = "cat_weapon",  type = "check", val = 1, def = defaults.cat_weapon },
                                { id = "cat_voice",   type = "check", val = 1, def = defaults.cat_voice },
                                { id = "cat_step",    type = "check", val = 1, def = defaults.cat_step },
                                { id = "cat_monster", type = "check", val = 1, def = defaults.cat_monster },
                                { id = "cat_anomaly", type = "check", val = 1, def = defaults.cat_anomaly },
                                { id = "cat_other",   type = "check", val = 1, def = defaults.cat_other },
                        } },
                        { id = "detect", sh = true, text = "ui_mcm_sound_vision_section_detect", gr = {
                                { id = "title_detect", type = "title", text = "ui_mcm_sound_vision_section_detect" },
                                { id = "anm_pulse",   type = "track", val = 2,
                                        def = defaults.anm_pulse, min = 2, max = 10, step = 1 },
                                { id = "phys_enable", type = "check", val = 1, def = defaults.phys_enable },
                                { id = "phys_sens",   type = "track", val = 2,
                                        def = defaults.phys_sens, min = 5, max = 50, step = 1 },
                                { id = "npc_shots",   type = "check", val = 1, def = defaults.npc_shots },
                        } },
                        -- v2.8: виньетка центра - индикация не перекрывает прицел
                        -- и противника, когда вы смотрите прямо на них
                        { id = "vignette", sh = true, text = "ui_mcm_sound_vision_section_vignette", gr = {
                                { id = "title_vignette", type = "title", text = "ui_mcm_sound_vision_section_vignette" },
                                { id = "vign_on",   type = "check", val = 1, def = defaults.vign_on },
                                { id = "vign_min",  type = "track", val = 2,
                                        def = defaults.vign_min, min = 2, max = 50, step = 2 },
                                { id = "vign_core", type = "track", val = 2,
                                        def = defaults.vign_core, min = 10, max = 80, step = 5 },
                                { id = "vign_full", type = "track", val = 2,
                                        def = defaults.vign_full, min = 40, max = 150, step = 10 },
                        } },
                        -- v2.8: учёт перекрытия - видимые источники не закрывают
                        -- противника, источники за стеной - мутные размытые ореолы
                        { id = "occlusion", sh = true, text = "ui_mcm_sound_vision_section_occlusion", gr = {
                                { id = "title_occlusion", type = "title", text = "ui_mcm_sound_vision_section_occlusion" },
                                { id = "occ_on",      type = "check", val = 1, def = defaults.occ_on },
                                { id = "occ_visible", type = "track", val = 2,
                                        def = defaults.occ_visible, min = 10, max = 90, step = 5 },
                                { id = "occ_wall",    type = "track", val = 2,
                                        def = defaults.occ_wall, min = 0, max = 100, step = 5 },
                                { id = "occ_soft",    type = "check", val = 1, def = defaults.occ_soft },
                                { id = "occ_boost",   type = "track", val = 2,
                                        def = defaults.occ_boost, min = 100, max = 180, step = 10 },
                                { id = "occ_vign",    type = "check", val = 1, def = defaults.occ_vign },
                        } },
                        { id = "debug", sh = true, text = "ui_mcm_sound_vision_section_debug", gr = {
                                { id = "title_debug", type = "title", text = "ui_mcm_sound_vision_section_debug" },
                                { id = "debug_logs", type = "check", val = 1, def = defaults.debug_logs },
                                { id = "dbg_types",  type = "check", val = 1, def = defaults.dbg_types },
                        } },
                }
        }
        return op
end
