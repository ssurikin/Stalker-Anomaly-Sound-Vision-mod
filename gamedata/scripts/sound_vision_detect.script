-- ============================================================================
-- sound_vision_detect: обнаружение звуков опросом мира (4 Гц)
--
-- Ответственность (SRP): один проход по db.storage раз в MOVE_POLL_MS:
--   - движение живых NPC/мутантов -> "шаги" (гарантированно, сквозь стены);
--   - движение трупов/физики (бочки, коробки) -> "физика"
--     (толкание, скольжение, падение; гранаты с v2.9 - отдельный канал
--     взрывов, физические кольца за ними не закреплены);
--   - аномальные зоны -> периодический "гул" (idle-звук зон играет циклично
--     с паузами - имитируем его пульсами) + "шипение" при приближении;
--   - болт: пролетел и остановился рядом с зоной -> активация аномалии;
--   - гранаты в полёте (v2.9): летящий снаряд следится до потолка взрывов,
--     его исчезновение = взрыв (кольцо в точке последнего sighting).
-- События отправляет через sound_vision_events, сам ничего не рисует.
--
-- Громкость опрошенных источников (v2.0). Опрос - единственный источник
-- данных там, где движок ничего не сообщает: шаги сталкеров играются через
-- play_no_feedback без типа (Event_Propagade их не рассылает ИИ), физика
-- без ИИ-событий, зоны работают на скриптах. Для таких событий громкость
-- у игрока оценивается виртуальным якорем (d_v, p_v): считается, что на
-- расстоянии d_v источник имел громкость p_v, дальше - обратный квадрат
-- pp = p_v * (d_v/dp)^2 (см. sound_vision_events). Якоря подобраны по
-- слышимости в игре и лежат здесь в одном месте (ANV): это НЕ калибровка
-- отдельных источников - 4 числа на ВСЕ опрошенные события.
-- Шаги: громкость растёт со СКОРОСТЬЮ движения (крадётся/идёт/бежит),
-- измеряемой по смещению между опросами.
--
-- Зависимости: sound_vision_config, sound_vision_events (лениво).
--
-- Экспорт:
--   update(now) - кадр игрока: опрос мира и чистка по своим таймерам
--   clear()     - полный сброс состояния (загрузка игры)
--
-- Отладка (MCM -> Отладка -> Журнал отладки): каждое обнаружение пишется
-- строкой DETECT (шаги - не чаще раза в секунду на персонажа); решение
-- очереди пишут GATE/QUEUE (см. sound_vision_log).
-- ============================================================================

local MOVE_POLL_MS = 250    -- период опроса мира
local CLEANUP_MS   = 5000   -- период чистки осиротевшего состояния
local STEP_MIN_D2  = 0.06   -- ~0.25 м за опрос => живой персонаж движется
local BOLT_STOP_MS = 450    -- болт неподвижен столько - он "приземлился"
local ZONE_NEAR_M  = 3.0    -- ближе стольких метров до центра зоны - она "шипит"
local ZONE_BOLT_R2 = 64     -- (8 м)^2 - болт остановился рядом с зоной => активация
local BOLT_FLEW_D2 = 1.0    -- (1 м)^2 - болт должен пролететь хотя бы метр

-- Виртуальные якоря громкости: { d_v, p_v } - на d_v метрах громкость p_v.
-- Дальше громкость падает обратным квадратом. Подобраны по слышимости
-- в игре (при пороге по умолчанию 0.02 даёт радиусы: шаги ~15-35 м
-- по скорости, физика ~20 м, гул зоны ~40 м, шипение ~46 м).
local ANV_STEP     = { 10, 0.10 }  -- опорная громкость шага (крадущийся)
local ANV_STEP_RUN = 0.24          -- громкость шага на спринте (якорь тот же)
local ANV_STEP_V   = 6.0           -- скорость полного "спринтового" шага, м/с
local ANV_PHYS     = { 8, 0.12 }   -- скольжение/толкание бочек и коробок
local ANV_ZONE     = { 15, 0.15 }  -- гул аномалии в простое
local ANV_ZONE_ACT = { 12, 0.30 }  -- шипение активации зоны / вход игрока

-- Взрыв гранаты (v2.9). Опрос - гарантированный канал взрывов: он не
-- зависит ни от ИИ-слушателей (актёр слух в Lua не отчитывает - чужой
-- брошенный гранат в пустой локации иначе не видно), ни от ogg-метаданных.
-- Движковый факт: летящий снаряд - живой объект без родителя (Missile.cpp:
-- spawn_fake_missile спавнит по cNameSect, GE_OWNERSHIP_REJECT отпускает
-- его в полёт), при взрыве CGrenade уничтожается - исчезновение из
-- db.storage и есть момент взрыва. Громкость - от якоря: взрыв гранаты
-- слышно до ~100 м; громкость у игрока идёт на размер кольца (в очереди).
-- Бочки/мины/взрывчатку ловит колбэк explosive_item_on_explode
-- (sound_vision) - опрос следит только за гранатными классами clsid
-- (все ключи _G.clsid с префиксом wpn_grenade: ручные и подствольные
-- "фейки"; движок регистрирует G_F1_S/G_RGD5_S/G_FAKE).
local ANV_EXPL        = { 25, 0.80 }  -- взрыв гранаты: слышно до ~100 м
local EXPL_TRACK_D2   = 200 * 200     -- потолок слежения = потолок дальности взрывов
local EXPL_TRACK_D2_SQRT = 200        -- тот же потолок в метрах (для sqrt-сравнения)
local gren_state = {}   -- [id] = {x,y,z,sec} - летящие гранаты (последняя точка)
local cls_cache  = {}   -- [id] = clsid|false - кэш классов объектов
local grenade_clsids = nil  -- [clsid] = true - ленивый набор из _G.clsid

local move_timer    = 0
local cleanup_timer = 0

local last_pos   = {}   -- [id] = {x,y,z} - прошлая позиция (для движения)
local sections   = {}   -- [id] = секция объекта (кэш)
local zone_state = {}   -- [id] = {next=мс, near=bool} - пульс гула зон
local zone_pos   = {}   -- [id] = {x,y,z} - центры зон рядом (для болтов)
local bolt_state = {}   -- [id] = {sx,sy,sz,lx,ly,lz,still,done}

-- Ленивая инициализация (см. sound_vision_events).
local cfg, push_event
local function init()
        if not cfg then
                local cmod = _G.sound_vision_config
                local emod = _G.sound_vision_events
                if cmod and emod then
                        cfg = cmod.mc
                        push_event = emod.push_event
                end
        end
end

-- Громкость у игрока от виртуального якоря: pp = p_v * (d_v/dp)^2.
-- Кламп сверху 1: у самого источника громкость не больше единицы.
local function anchor_loud(anv, dp)
        local dv, pv = anv[1], anv[2]
        if dp < 0.5 then return 1 end
        local pp = pv * (dv / dp) * (dv / dp)
        if pp > 1 then pp = 1 end
        return pp
end

local function starts_with(s, sub)
        return string.find(s, sub, 1, true) == 1
end

-- Набор гранатных clsid (v2.9): все ключи _G.clsid с префиксом "wpn_grenade"
-- (wpn_grenade_f1_s, wpn_grenade_rgd5_s, wpn_grenade_fake - подствольный).
-- Строится один раз; добавляет гранаты любых аддонов, зарегистрированные
-- движком под тем же префиксом.
local function gren_clsids()
        if grenade_clsids then return grenade_clsids end
        grenade_clsids = {}
        local ct = _G.clsid
        if type(ct) == "table" then
                for name, v in pairs(ct) do
                        if type(name) == "string" and starts_with(name, "wpn_grenade") then
                                grenade_clsids[v] = true
                        end
                end
        end
        return grenade_clsids
end

-- Кэш clsid объекта: метод щупается один раз за жизнь объекта (false -
-- недоступен на этой сборке). clsid - не строка: сравнивать с наборами чисел.
local function clsid_of(o, id)
        local c = cls_cache[id]
        if c == nil then
                local ok, v = pcall(o.clsid, o)
                c = ok and v or false
                cls_cache[id] = c
        end
        return c
end

-- Дымовые/газовые гранаты без взрывного урона (hit_type_blast ~= "explosion",
-- как у m_gsmoke: strike) кольца взрыва не дают. Отсутствие строки - не
-- приговор: секция без hit_type_blast считается взрывчаткой (по умолчанию
-- показываем - ореол от редкого события лучше пропущенного взрыва).
local function explodes_on_death(sec)
        local ini = _G.ini_sys
        if not (ini and sec) then return true end
        local ok, v = pcall(ini.r_string, ini, sec, "hit_type_blast")
        return (not ok) or v == "explosion"
end

local function excluded_section(s)
        -- оружие/патроны в руках NPC дублировали бы кольца самого NPC;
        -- артефакты левитируют в зонах и шумели бы постоянно
        return starts_with(s, "wpn_") or starts_with(s, "ammo_") or starts_with(s, "af_")
end

local function nearest_zone_id(x, y, z)
        local best, bd2 = nil, ZONE_BOLT_R2
        for zid, zp in pairs(zone_pos) do
                local dx, dy, dz = x - zp.x, y - zp.y, z - zp.z
                local d2 = dx * dx + dy * dy + dz * dz
                if d2 < bd2 then
                        bd2 = d2
                        best = zid
                end
        end
        return best
end

local function process_object(o, id, ap, maxd2, now)
        local pos = o:position()
        local ddx, ddz = pos.x - ap.x, pos.z - ap.z
        local dd2 = ddx * ddx + ddz * ddz

        -- 0) гранаты в полёте (v2.9): следим до потолка взрывов (дальше радиуса
        -- опроса мира - подствольный снаряд летит за 100 м, и слух там часто
        -- молчит). Родитель есть - снаряд в чьих-то руках/в стволе: не полёт.
        if gren_clsids()[clsid_of(o, id)] then
                local ok_par, par = pcall(o.parent, o)
                if ok_par and par then
                        gren_state[id] = nil
                        return
                end
                local gp = gren_state[id]
                if gp then
                        gp.x, gp.y, gp.z = pos.x, pos.y, pos.z
                else
                        local ok_s, s = pcall(o.section, o)
                        gren_state[id] = { x = pos.x, y = pos.y, z = pos.z,
                                sec = ok_s and s or nil }
                end
                if dd2 >= EXPL_TRACK_D2 then
                        gren_state[id] = nil   -- дальше потолка взрывов кольцо всё равно не рисуется
                end
                return
        end

        if dd2 >= maxd2 then
                if zone_pos[id] then zone_pos[id] = nil end
                if zone_state[id] then zone_state[id] = nil end
                if last_pos[id] then last_pos[id] = nil end
                return
        end

        local sec = sections[id]
        if not sec then
                sec = o:section() or ""
                sections[id] = sec
        end

        local is_mob = (IsStalker(o) or IsMonster(o)) and true or false
        local lp = last_pos[id]
        local md2 = 0
        if lp then
                md2 = (pos.x - lp.x) * (pos.x - lp.x)
                        + (pos.y - lp.y) * (pos.y - lp.y)
                        + (pos.z - lp.z) * (pos.z - lp.z)
        end

        -- Журнал: опрос мира увидел издающих (MCM: Отладка). Дальше решение
        -- очереди (GATE/QUEUE) пишут свои строки; здесь - сам факт обнаружения.
        local L = _G.sound_vision_log
        local dbg, rate = nil, nil
        if L and L.on() then dbg, rate = L.dbg, L.rate end

        -- 1) живые персонажи: шаги. Громкость - от скорости: крадётся тихо,
        --    идёт средне, бежит громко (см. ANV_STEP* в шапке).
        if is_mob and o:alive() then
                if lp and md2 > STEP_MIN_D2 then
                        local v = math.sqrt(md2) / (MOVE_POLL_MS / 1000)
                        local k = v / ANV_STEP_V
                        if k > 1 then k = 1 end
                        local pv = ANV_STEP[2] + (ANV_STEP_RUN - ANV_STEP[2]) * k
                        local dp = math.sqrt(dd2 + (pos.y - ap.y) * (pos.y - ap.y))
                        if dbg and rate("det_step_" .. id, 1000) then
                                dbg("DETECT", "step: %s (%s) v=%.1fm/s loud=%.3f d=%.1fm",
                                        L.who(id), tostring(sec), v,
                                        anchor_loud({ ANV_STEP[1], pv }, dp), dp)
                        end
                        push_event(pos.x, pos.y, pos.z, "step", "mv" .. id,
                                false, anchor_loud({ ANV_STEP[1], pv }, dp))
                end
                if lp then
                        lp.x, lp.y, lp.z = pos.x, pos.y, pos.z
                else
                        last_pos[id] = { x = pos.x, y = pos.y, z = pos.z }
                end
                return
        end

        -- 2) аномальные зоны: гул + активация при приближении
        if starts_with(sec, "zone_") then
                local zs = zone_state[id]
                local d3 = math.sqrt(dd2 + (pos.y - ap.y) * (pos.y - ap.y))
                local near = d3 < ZONE_NEAR_M
                if not zs then
                        zs = { next = 0, near = near }
                        zone_state[id] = zs
                end
                zone_pos[id] = { x = pos.x, y = pos.y, z = pos.z }
                if near and not zs.near then
                        -- подход/вход: зона активируется (шипение)
                        local dp = d3
                        if dbg then
                                dbg("DETECT", "zone hiss (activation): %s loud=%.3f d=%.1fm",
                                        tostring(sec), anchor_loud(ANV_ZONE_ACT, dp), dp)
                        end
                        push_event(pos.x, pos.y, pos.z, "anomaly", "anm" .. id,
                                true, anchor_loud(ANV_ZONE_ACT, dp))
                end
                if now >= (zs.next or 0) then
                        if dbg then
                                dbg("DETECT", "zone hum (idle pulse): %s loud=%.3f d=%.1fm",
                                        tostring(sec), anchor_loud(ANV_ZONE, d3), d3)
                        end
                        push_event(pos.x, pos.y, pos.z, "anomaly", "anm" .. id,
                                false, anchor_loud(ANV_ZONE, d3))
                        local interval
                        if near then
                                interval = 1100 + math.random(0, 400)
                        else
                                interval = cfg.anm_pulse * 1000 + math.random(0, 2000)
                        end
                        zs.next = now + interval
                end
                zs.near = near
                return
        end

        -- 3) болты: остановился рядом с зоной => активация
        if starts_with(sec, "bolt") then
                local bs = bolt_state[id]
                if not bs then
                        bs = { sx = pos.x, sy = pos.y, sz = pos.z,
                                lx = pos.x, ly = pos.y, lz = pos.z,
                                still = 0, done = false }
                        bolt_state[id] = bs
                else
                        local bdx = pos.x - bs.lx
                        local bdy = pos.y - bs.ly
                        local bdz = pos.z - bs.lz
                        if bdx * bdx + bdy * bdy + bdz * bdz > 0.0025 then
                                bs.still = 0
                        else
                                bs.still = bs.still + MOVE_POLL_MS
                        end
                        bs.lx, bs.ly, bs.lz = pos.x, pos.y, pos.z
                        local sdx = pos.x - bs.sx
                        local sdy = pos.y - bs.sy
                        local sdz = pos.z - bs.sz
                        if not bs.done and bs.still >= BOLT_STOP_MS
                                and (sdx * sdx + sdy * sdy + sdz * sdz) > BOLT_FLEW_D2 then
                                bs.done = true
                                local zid = nearest_zone_id(pos.x, pos.y, pos.z)
                                if zid then
                                        local zp = zone_pos[zid]
                                        local dzx, dzy, dzz = zp.x - ap.x, zp.y - ap.y, zp.z - ap.z
                                        local dpz = math.sqrt(dzx * dzx + dzy * dzy + dzz * dzz)
                                        if dbg then
                                                dbg("DETECT", "bolt landed near zone: %s loud=%.3f d=%.1fm",
                                                        tostring(sections[zid]),
                                                        anchor_loud(ANV_ZONE_ACT, dpz), dpz)
                                        end
                                        push_event(zp.x, zp.y, zp.z, "anomaly", "anm_act",
                                                true, anchor_loud(ANV_ZONE_ACT, dpz))
                                        if zone_state[zid] then
                                                zone_state[zid].next = now + 1500
                                        end
                                end
                        end
                end
                return
        end

        -- 4) физика: трупы, бочки, коробки, гранаты, брошенные вещи
        if cfg.phys_enable and not excluded_section(sec) and lp then
                if md2 > cfg.phys_sens * cfg.phys_sens then
                        local dp = math.sqrt(dd2 + (pos.y - ap.y) * (pos.y - ap.y))
                        if dbg and rate("det_phys_" .. id, 1000) then
                                dbg("DETECT", "phys move: %s (%s) loud=%.3f d=%.1fm",
                                        L.who(id), tostring(sec),
                                        anchor_loud(ANV_PHYS, dp), dp)
                        end
                        push_event(pos.x, pos.y, pos.z, "other", "mv" .. id,
                                false, anchor_loud(ANV_PHYS, dp))
                end
        end
        if lp then
                lp.x, lp.y, lp.z = pos.x, pos.y, pos.z
        else
                last_pos[id] = { x = pos.x, y = pos.y, z = pos.z }
        end
end

local function poll_world()
        local a = db.actor
        if not a or not a:alive() then return end
        local aid = a:id()
        local ap = a:position()
        local maxd2 = (cfg.max_dist + 5) * (cfg.max_dist + 5)
        local now = time_global()

        for id, st in pairs(db.storage) do
                local o = st and st.object
                if o and id ~= aid then
                        pcall(process_object, o, id, ap, maxd2, now)
                end
        end
end

-- Чистка состояния объектов, исчезнувших из db.storage (деспавн, смена уровня).
local function cleanup_stale()
        for id in pairs(last_pos) do
                if not db.storage[id] then
                        last_pos[id] = nil
                        sections[id] = nil
                        zone_state[id] = nil
                        zone_pos[id] = nil
                        bolt_state[id] = nil
                end
        end
        for id in pairs(sections) do
                if not db.storage[id] then sections[id] = nil end
        end
        for id in pairs(zone_state) do
                if not db.storage[id] then
                        zone_state[id] = nil
                        zone_pos[id] = nil
                end
        end
        for id in pairs(bolt_state) do
                if not db.storage[id] then bolt_state[id] = nil end
        end
        for id in pairs(cls_cache) do
                if not db.storage[id] then cls_cache[id] = nil end
        end
        -- исчезнувшая граната оформится взрывом в poll_grenades на следующем
        -- такте опроса; здесь только страховка чистки кэша классов
        for id in pairs(gren_state) do
                if not db.storage[id] then cls_cache[id] = nil end
        end
end

-- Взрывы гранат (v2.9): следим за исчезновением летящих снарядов. Снаряд
-- из db.storage пропадает при взрыве (CGrenade уничтожается); подбор и
-- возвращение в чей-то инвентарь объект НЕ уничтожают (меняется родитель -
-- process_object снимет слежение), поэтому ложных взрывов нет. Громкость -
-- от якоря ANV_EXPL: честного замера у опроса нет.
local function poll_grenades()
        if next(gren_state) == nil then return end
        local a = db.actor
        if not a then return end
        local ap = a:position()
        local L = _G.sound_vision_log
        local dbg, rate = nil, nil
        if L and L.on() then dbg, rate = L.dbg, L.rate end
        for gid, gp in pairs(gren_state) do
                if not db.storage[gid] then
                        gren_state[gid] = nil
                        local dx, dy, dz = gp.x - ap.x, gp.y - ap.y, gp.z - ap.z
                        local d = math.sqrt(dx * dx + dy * dy + dz * dz)
                        if d <= EXPL_TRACK_D2_SQRT and explodes_on_death(gp.sec) then
                                local loud = anchor_loud(ANV_EXPL, d)
                                if dbg and rate("gren_" .. tostring(gid), 1000) then
                                        dbg("DETECT", "grenade gone (boom): %s loud=%.3f d=%.1fm",
                                                tostring(gp.sec), loud, d)
                                end
                                -- who - ЧИСЛОВОЙ id гранаты: слуховой канал даёт тот
                                -- же ключ, копии каналов склеиваются в очереди.
                                -- force НЕ ставим: ключ общий, антиспам и есть
                                -- механизм склейки копий (слух приходит первым -
                                -- опросная копия оттроттлится, и наоборот)
                                push_event(gp.x, gp.y, gp.z, "explosion", gid, nil, loud, true)
                        end
                end
        end
end

-- Кадр игрока: опрос мира и чистка каждый по своему таймеру.
local function update(now)
        init()
        if not cfg or not push_event then return end
        if now - move_timer >= MOVE_POLL_MS then
                move_timer = now
                poll_world()
                poll_grenades()   -- исчезновение летящих гранат = взрыв (v2.9)
        end
        if now - cleanup_timer >= CLEANUP_MS then
                cleanup_timer = now
                cleanup_stale()
        end
end

-- Полный сброс состояния (загрузка игры).
local function clear()
        for k in pairs(last_pos) do last_pos[k] = nil end
        for k in pairs(sections) do sections[k] = nil end
        for k in pairs(zone_state) do zone_state[k] = nil end
        for k in pairs(zone_pos) do zone_pos[k] = nil end
        for k in pairs(bolt_state) do bolt_state[k] = nil end
        for k in pairs(gren_state) do gren_state[k] = nil end
        for k in pairs(cls_cache) do cls_cache[k] = nil end
        move_timer = 0
        cleanup_timer = 0
end

-- ============================================================================
-- Экспорт модуля
-- ============================================================================
_G.sound_vision_detect = {
        update = update,
        clear = clear,
}
